}

print_status() {
  local last; last="$(state_get last-phase)"
  if [[ -z "$last" ]]; then
    info "No phase has run yet. Start with: ./srsx-migrate"
    return 0
  fi
  info "Last completed phase: ${C_BOLD}${last}${C_RST}"
  # Suggest next phase.
  local i=0
  for p in "${PHASE_ORDER[@]}"; do
    if [[ "$p" == "$last" ]]; then
      local next="${PHASE_ORDER[$((i+1))]:-(done)}"
      info "Next:                 ${C_BOLD}${next}${C_RST}"
      info "Run:                  ./srsx-migrate ${next}"
      return 0
    fi
    ((++i))
  done
}

print_explain() {
  local phase="${1:-}"
  [[ -n "$phase" ]] || err "Usage: ./srsx-migrate explain <phase>"
  [[ -n "${PHASE_DESC[$phase]:-}" ]] || err "Unknown phase: ${phase}
       Valid phases: ${PHASE_ORDER[*]}"
  printf '%s%s%s\n' "$C_BOLD" "$phase" "$C_RST"
  printf '  %s\n' "${PHASE_DESC[$phase]}"
  printf '  Acquia doc: %s\n' "${PHASE_DOC[$phase]:-(none)}"
}

run_all() {
  local started=0
  local from="${RUN_FROM:-${PHASE_ORDER[0]}}"
  for p in "${PHASE_ORDER[@]}"; do
    if [[ "$started" == "0" ]]; then
      if [[ "$p" == "$from" ]]; then
        started=1
      else
        continue
      fi
    fi
    case "$p" in
      cleanup)
        # Cleanup is dangerous; always pause before it.
        confirm "About to run final cleanup (uninstall acquia_search etc.). Skip with Ctrl-C if not ready."
        "phase_$p"
        ;;
      *)
        "phase_$p"
        demo_pause
        ;;
    esac
  done
}

dispatch() {
  case "${1:-interactive}" in
    interactive)
      ensure_init
      if [[ "$FORCE" == "1" ]]; then
        clear_progress_state
        RUN_FROM="${PHASE_ORDER[0]}"
      else
        resume_or_select
      fi
      run_all
      ;;
    all)
      ensure_init
      if [[ "$FORCE" == "1" ]]; then
        clear_progress_state
      fi
      RUN_FROM="${PHASE_ORDER[0]}"
      run_all
      ;;
    init)
      # Full reset of the setup wizard: clear the marker AND every saved
      # answer (app, env, multisite) so all questions are asked again.
      rm -f "${STATE_DIR}/init.done"
      ACQUIA_APP=""; ACQUIA_TARGET_ENV=""
      SITES=""; SITES_ARR=()
      ensure_init
      ;;
    preflight|install|backup|provision|configure|server|index|views|route|handoff|cleanup)
      ensure_init
      "phase_$1"
      ;;
    validate)
      ensure_init
      "phase_validate"
      ;;
    status)              print_status ;;
    explain)             shift; print_explain "${1:-}" ;;
    --help|-h|help)      print_help ;;
    --version|-V)        printf '%s %s\n' "$SCRIPT_NAME" "$SCRIPT_VERSION" ;;
    *)
      err "Unknown command: $1
       Run './srsx-migrate --help' for usage."
      ;;
  esac
}

# =============================================================================
# MAIN
# =============================================================================

main() {
  # Parse global flags first (in any order before the subcommand).
  local -a positional=()
  local env_override=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run)   DRY_RUN=1; shift ;;
      --demo)      enable_demo_mode; shift ;;
      --no-color)  USE_COLOR=0; shift ;;
      --yes|-y)    ASSUME_YES=1; shift ;;
      --force)     FORCE=1; shift ;;
      --env)
        [[ $# -ge 2 ]] || err "--env requires a value (e.g. --env prod)"
        env_override="$2"; shift 2 ;;
      --env=*)     env_override="${1#--env=}"; shift ;;
      --)          shift; positional+=("$@"); break ;;
      *)           positional+=("$1"); shift ;;
    esac
  done

  init_colors
  load_env
  load_demo_answers

  # Set up logging (mirror everything to a per-run log).
  mkdir -p "$LOG_DIR"
  LOG_FILE="${LOG_DIR}/$(date +%Y%m%d-%H%M%S)-srsx.log"
  exec > >(tee -a "$LOG_FILE") 2>&1
  # Make sure the tee subshell flushes whatever we printed before the script
  # exits — otherwise quick exits (e.g. "already complete") show nothing.
  trap 'exec >&- 2>&-; wait 2>/dev/null || true' EXIT

  # --env <name> is only honored by the read-only `validate` subcommand.
  # Anywhere else it is silently ignored — we never let an arbitrary flag
  # change the target of a mutating phase.
  if [[ -n "$env_override" ]]; then
    if [[ "${positional[0]:-}" == "validate" ]]; then
      EFFECTIVE_ENV="$env_override"
      if is_prod_env "$env_override"; then
        ALLOW_PROD_ENV=1
        warn "Running validate against production env '${env_override}' (read-only)."
      fi
    else
      warn "--env is only honored by 'validate'. Ignored for '${positional[0]:-interactive}'."
    fi
  fi

  dispatch "${positional[@]:-interactive}"
}

main "$@"
