state_set() {
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$2" > "${STATE_DIR}/$1"
}

state_get() {
  [[ -f "${STATE_DIR}/$1" ]] && cat "${STATE_DIR}/$1" || echo ""
}

# =============================================================================
# PREREQUISITES & ENV LOADING
# =============================================================================

require_cmd() {
  command -v "$1" >/dev/null 2>&1 && return 0
  local hint=""
  case "$1" in
    acli)
      hint="  macOS:        brew install --cask acli
       Linux/other:  https://docs.acquia.com/acquia-cli/install/
       Then:         acli auth:login"
      ;;
    composer)
      hint="  macOS:        brew install composer
       Linux:        https://getcomposer.org/download/"
      ;;
    jq)
      hint="  macOS:        brew install jq
       Ubuntu/Debian:sudo apt-get install -y jq
       Acquia IDE:   already installed"
      ;;
    git)
      hint="  macOS:        brew install git (or 'xcode-select --install')
       Ubuntu/Debian:sudo apt-get install -y git"
      ;;
    *)
      hint="  Install '$1' via your platform's package manager, then re-run."
      ;;
  esac
  err "Required command not found: $1
${hint}"
}

load_env() {
  local envfile="$ENV_FILE"
  if [[ -f "$envfile" ]]; then
    # shellcheck disable=SC1090
    source "$envfile"
  fi

  # Parse SITES env into the array (comma-separated).
  if [[ -n "${SITES:-}" ]]; then
    IFS=',' read -r -a SITES_ARR <<< "$SITES"
  fi

  # EFFECTIVE_ENV defaults to ACQUIA_TARGET_ENV; --env <name> on dispatch overrides for validate.
  EFFECTIVE_ENV="${ACQUIA_TARGET_ENV:-}"
}

# True if the given env name looks like a production env. Mutating phases
# only target dev/stage; the read-only `validate` phase can still target any
# env, including prod, after the changes have been deployed.
is_prod_env() {
  local name; name="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  for p in "${PROD_ENV_NAMES[@]}"; do
    [[ "$name" == "$p" ]] && return 0
  done
  return 1
}

# Parse comma-separated DEMO_ANSWERS env var into array (consumed by ask*).
declare -a DEMO_ANSWERS_ARR=()
load_demo_answers() {
  if [[ -n "${DEMO_ANSWERS:-}" ]]; then
    IFS=',' read -r -a DEMO_ANSWERS_ARR <<< "$DEMO_ANSWERS"
  fi
}

# =============================================================================
# DEMO MODE — PATH SHIMMING
# =============================================================================

enable_demo_mode() {
  local demo_bin="${SCRIPT_DIR}/lib/demo/bin"
  [[ -d "$demo_bin" ]] || err "Demo bin dir missing: $demo_bin
       (Was the toolkit installed via install.sh? See README.md.)"
  export PATH="${demo_bin}:${PATH}"
  export SRSX_DEMO_FIXTURES="${SCRIPT_DIR}/lib/demo/fixtures"
  DEMO=1
  warn "Demo mode active. PATH prefixed with ${demo_bin}"

  # Use a stable, predictable throw-away SRSX_HOME so the demo behaves exactly
  # like a real run (wizard prompts on first invocation, resume across repeat
  # invocations) without touching the toolkit's own files. SRSX_HOME may be
  # pre-set in the environment to pin a custom location (used by tests).
  local demo_home="${SRSX_DEMO_HOME:-${TMPDIR:-/tmp}/srsx-demo-home}"
  mkdir -p "${demo_home}/config/sync"
  ( cd "$demo_home" && [[ ! -d .git ]] && command git init -q 2>/dev/null || true )
  REPO_ROOT="$demo_home"

  # Where the shims record "the copy already happened". Kept out of the repo's
  # fixtures dir so a demo run leaves no tracked files behind and the next run
  # starts before the copy rather than after it.
  export SRSX_DEMO_STATE="${demo_home}/demo-state"
  rm -rf "$SRSX_DEMO_STATE"
  mkdir -p "$SRSX_DEMO_STATE"

  # Rebase all runtime paths under the throwaway home so the wizard's saved
  # migration.env, state markers, logs, and artifacts all live there.
  SRSX_HOME="$demo_home"
  ARTIFACTS_DIR="${SRSX_HOME}/artifacts"
  LOG_DIR="${SRSX_HOME}/logs"
  STATE_DIR="${SRSX_HOME}/state"
  ENV_FILE="${SRSX_HOME}/migration.env"

  info "Demo home: ${SRSX_HOME}"
  info "  (migration.env, state/, logs/, artifacts/ live here; rm -rf to reset)"
}

# =============================================================================
# FIRST-RUN WIZARD + RESUME + IDEMPOTENCY GUARDS
# =============================================================================

# ensure_init — interactive first-run wizard. Captures ACQUIA_APP and
# ACQUIA_TARGET_ENV (defaults dev), persists to migration.env, and writes
# state/init.done so we never ask again.
ensure_init() {
  if [[ -f "${STATE_DIR}/init.done" ]] \
     && [[ -n "${ACQUIA_APP:-}" ]] \
     && [[ -n "${ACQUIA_TARGET_ENV:-}" ]]; then
    # Don't clobber an EFFECTIVE_ENV that was set by --env <name> on the CLI.
    : "${EFFECTIVE_ENV:=${ACQUIA_TARGET_ENV}}"
    return 0
  fi

  # Fresh run (no init.done) OR incomplete state. Clear all init-related
  # variables so the wizard asks every question. This handles the case where
  # migration.env has a stale ACQUIA_TARGET_ENV from a previous partial run
  # but ACQUIA_APP is missing — without this, we'd skip the env question.
  if [[ ! -f "${STATE_DIR}/init.done" ]]; then
    ACQUIA_APP=""
    ACQUIA_TARGET_ENV=""
    SITES=""
    SITES_ARR=()
  fi

  printf '%s%s── First-run setup ──%s\n\n' "$C_HEAD" "$C_BOLD" "$C_RST"
  cat <<EOF
This toolkit migrates your Drupal Search-API configuration from Acquia
Search to Acquia Search powered by SearchStax. You run it from your Cloud
IDE or local clone against your Acquia DEV (or STAGE) environment via
'acli remote:drush'. Once you've validated the result on dev/stage, you
deploy the staged config changes to production through your normal Acquia
workflow.

You can re-run this wizard any time:  ./srsx-migrate init

EOF

  if [[ -z "${ACQUIA_APP:-}" ]]; then
    if command -v acli >/dev/null 2>&1 \
       && [[ "$DEMO" != "1" ]] && [[ "$DRY_RUN" != "1" ]] && [[ -t 0 ]]; then
      info "Looking up your Acquia applications…"
      audit "acli api:applications:find"
      acli api:applications:find 2>/dev/null \
        | head -40 \
        | sed 's/^/    /' || true
      printf '\n'
    fi
    ask "Acquia application alias or UUID (e.g. myapp)" ACQUIA_APP
    [[ -n "$ACQUIA_APP" ]] || err "ACQUIA_APP cannot be empty."
  fi

  if [[ -z "${ACQUIA_TARGET_ENV:-}" ]]; then
    while :; do
      ask "Target environment for this migration run (dev or stage)" \
          ACQUIA_TARGET_ENV "dev"
      if is_prod_env "$ACQUIA_TARGET_ENV"; then
        warn "Pick 'dev' or 'stage' here. The toolkit runs the mutating phases against a
       lower environment so you can test the migrated search before it reaches
       your live site. Once you're happy, deploy the staged changes to prod
       through your normal Acquia workflow."
        ACQUIA_TARGET_ENV=""
        continue
      fi
      break
    done
  fi

  # Multisite. Single-site is the default. If multisite, ask for the comma-
  # separated list of --uri values; phases iterate over them automatically.
  if [[ -z "${SITES:-}" ]] && (( ${#SITES_ARR[@]} == 0 )); then
    local is_multi
    ask "Is this a Drupal multisite install? (y/N)" is_multi "n"
    if [[ "$is_multi" =~ ^[Yy] ]]; then
      local sites_csv
      ask "Comma-separated --uri values for sites to migrate (e.g. https://a.example.com,https://b.example.com)" \
          sites_csv
      [[ -n "$sites_csv" ]] || err "At least one --uri is required for multisite."
      SITES="$sites_csv"
      IFS=',' read -r -a SITES_ARR <<< "$SITES"
      _save_env_var SITES "$SITES"
    else
      # Single-site: drop any stale multisite config left in migration.env
      # from a previous run so it doesn't silently re-apply.
      SITES=""; SITES_ARR=()
      _delete_env_var SITES
    fi
  fi

  EFFECTIVE_ENV="${ACQUIA_TARGET_ENV}"
  _save_env_var ACQUIA_APP "$ACQUIA_APP"
  _save_env_var ACQUIA_TARGET_ENV "$ACQUIA_TARGET_ENV"
  mkdir -p "$STATE_DIR"
  : > "${STATE_DIR}/init.done"

  ok "Saved: ACQUIA_APP=${ACQUIA_APP}, ACQUIA_TARGET_ENV=${ACQUIA_TARGET_ENV}"
  printf '\n'
}

# Block a mutating phase from running directly against a production env.
# The read-only `validate` phase has its own gate (ALLOW_PROD_ENV) so it can
# safely re-check prod after deployment.
guard_against_prod() {
  if [[ "$ALLOW_PROD_ENV" == "1" ]]; then
    return 0
  fi
  if is_prod_env "${EFFECTIVE_ENV:-}"; then
    err "Mutating phases run on dev/stage so you can validate the migration before
       it goes live. Re-run with ACQUIA_TARGET_ENV=dev (or stage), then deploy
       the staged changes to '${EFFECTIVE_ENV}' through your normal Acquia
       workflow."
  fi
}

# Idempotency: each phase records state/done-<phase> on success. On the next
# run, if the marker exists, the phase prints [OK] already complete and skips
# unless --force was passed.
phase_done_check() {
  local phase="$1"
  if [[ "$FORCE" == "1" ]]; then
    return 1
  fi
  [[ -f "${STATE_DIR}/done-${phase}" ]]
}

phase_done_mark() {
  phase_footer "$1"
  mkdir -p "$STATE_DIR"
  : > "${STATE_DIR}/done-$1"
  state_set "last-phase" "$1"
}

# Print phase completion summary with elapsed time.
phase_footer() {
  local phase="$1"
  local end_time; end_time="$(date +%s)"
  local elapsed=$((end_time - PHASE_START_TIME))
  local mins=$((elapsed / 60))
  local secs=$((elapsed % 60))
  printf '\n%s' "$C_HEAD"
  printf '═%.0s' {1..71}
  printf '%s\n' "$C_RST"
  printf '%s✓ Phase %s%s%s complete' "$C_OK" "$C_BOLD" "'$phase'" "$C_RST"
  if (( elapsed > 0 )); then
    printf ' (%dm %ds)' "$mins" "$secs"
  fi
  printf '\n%s' "$C_HEAD"
  printf '═%.0s' {1..71}
  printf '%s\n' "$C_RST"
}

phase_done_clear() {
  rm -f "${STATE_DIR}/done-$1"
}

# Clear resumability markers so the next run starts from preflight with a
# clean phase state.
clear_progress_state() {
  mkdir -p "$STATE_DIR"
  info "Clearing progress markers under ${STATE_DIR}/done-*"
  rm -f "${STATE_DIR}"/done-*
  rm -f "${STATE_DIR}/last-phase" \
        "${STATE_DIR}/module-installed" \
        "${STATE_DIR}/provisioned-app-id"
  rm -f "${STATE_DIR}"/provisioned-app-id-* 2>/dev/null || true
}

# Print "already complete" notice and return 0 (skip).
phase_skip_done() {
  local phase="$1"
  ok "Phase '${phase}' already complete on a previous run. Use --force to re-run."
  return 0
}

# resume_or_select — if a previous run left state/last-phase, ask the user
# whether to resume from the next phase, restart from preflight, or pick.
# Sets RUN_FROM (a phase name) for run_all() to honor.
RUN_FROM=""
resume_or_select() {
  local last; last="$(state_get last-phase)"
  if [[ -z "$last" ]]; then
    RUN_FROM="${PHASE_ORDER[0]}"
    return 0
  fi

  local next="" i=0
  for p in "${PHASE_ORDER[@]}"; do
    if [[ "$p" == "$last" ]]; then
      next="${PHASE_ORDER[$((i+1))]:-}"
      break
    fi
    i=$((i + 1))
  done

  if [[ -z "$next" ]]; then
    ok "All phases were completed on a previous run (last: ${last})."
    info "  To replay everything from scratch:  rm -rf state/ logs/ artifacts/  &&  $0 ${DEMO:+--demo }all"
    info "  To re-run one phase:                $0 ${DEMO:+--demo }<phase> --force"
    info "  To pick a starting phase:           $0 ${DEMO:+--demo }<phase>"
    info "  Valid phases: ${PHASE_ORDER[*]}"
    exit 0
  fi

  if [[ "$ASSUME_YES" == "1" ]] || [[ ! -t 0 ]]; then
    info "Resuming from '${next}' (last completed: ${last})"
    RUN_FROM="$next"
    return 0
  fi

  printf '%s%sPrevious run found.%s\n' "$C_BOLD" "$C_HEAD" "$C_RST"
  printf '  Last completed phase: %s\n\n' "$last"
  local choice
  ask_choice "What do you want to do?" choice \
    "Resume from '${next}' (recommended)" \
    "Restart from '${PHASE_ORDER[0]}' (clears progress)" \
    "Pick a specific phase"
  case "$choice" in
    Resume*)
      RUN_FROM="$next"
      ;;
    Restart*)
      clear_progress_state
      RUN_FROM="${PHASE_ORDER[0]}"
      ;;
    Pick*)
      local picked
      ask "Phase name to start from" picked "$next"
      [[ -n "${PHASE_DESC[$picked]:-}" ]] \
        || err "Unknown phase: ${picked}. Valid: ${PHASE_ORDER[*]}"
      RUN_FROM="$picked"
      ;;
  esac
}

# =============================================================================
# MULTISITE — honor SITES (comma-separated --uri values) from migration.env
# =============================================================================

# Run a phase function once per configured site. Single-site sites just calls
# the phase function once with no --uri.
for_each_site() {
  local fn="$1"
  if (( ${#SITES_ARR[@]} == 0 )); then
    DRUSH_URI=""
    "$fn"
    return
  fi
  for s in "${SITES_ARR[@]}"; do
    if [[ -n "$s" && "$s" != "default" ]]; then
      DRUSH_URI="$s"
      info "${C_BOLD}── Site: ${s} ──${C_RST}"
    else
      DRUSH_URI=""
    fi
    "$fn"
  done
  DRUSH_URI=""
}

# ---------------------------------------------------------------------------
# SITE → SEARCHSTAX-APP TOPOLOGY
#
# A multisite can spread its sites across one or more SearchStax apps, subject
# to the 9-sites-per-app cap. The mapping is captured once (by whichever of
# provision/configure runs first) and persisted to migration.env as:
#   SEARCHSTAX_APP_COUNT   number of apps (K)
#   SITE_APP_MAP           "uri1=1,uri2=1,uri3=2,..." (site → 1-based app index)
# Per-app credentials are stored suffixed _1.._K; app 1 also mirrors the
# unsuffixed SEARCHSTAX_* vars for single-site backward compatibility.
# ---------------------------------------------------------------------------

# Integer ceiling division: _ceil_div <numerator> <denominator>.
_ceil_div() { printf '%s' $(( ($1 + $2 - 1) / $2 )); }

# Echo the 1-based app index a site maps to (default 1 when unmapped/single).
_site_app_index() {
  local uri="$1"
  if [[ -n "${SITE_APP_MAP:-}" && -n "$uri" ]]; then
    local pair
    IFS=',' read -r -a _sam_pairs <<< "$SITE_APP_MAP"
    for pair in "${_sam_pairs[@]}"; do
      if [[ "${pair%%=*}" == "$uri" ]]; then
        printf '%s' "${pair##*=}"
        return 0
      fi
    done
  fi
  printf '1'
}

# Echo a comma-separated list of the sites mapped to app <k>.
_sites_for_app() {
  local k="$1" out="" s
  for s in "${SITES_ARR[@]}"; do
    [[ "$(_site_app_index "$s")" == "$k" ]] && out+="${out:+, }${s}"
  done
  printf '%s' "$out"
}

# Derive a stable Solr index_prefix slug from a site --uri. Strips scheme,
# keeps [A-Za-z0-9_], and appends '_' as a namespace separator.
_ssx_site_prefix() {
  local uri="$1"
  local host="${uri#*://}"; host="${host%%/*}"
  local slug; slug="$(printf '%s' "$host" | tr -c 'A-Za-z0-9_' '_')"
  slug="${slug%_}"
  printf '%s_' "$slug"
}

# Decompose a SearchStax Solr endpoint into what the module's connector stores.
# It parses the update endpoint with
#   @https://([^/:]+)/([^/]+)/([^/]+)/(update|select)$@   → host, context, core
# so path stays '/' and the account id is a separate 'context', not part of the
# path. Either handler may be pasted; the stored endpoint always ends /update.
# Sets SRSX_EP_SCHEME / _HOST / _PORT / _PATH / _CORE / _CONTEXT / _UPDATE.
_ssx_parse_endpoint() {
  local url="$1" rest hostport host port path

  rest="${url#*://}"
  hostport="${rest%%/*}"
  if [[ "$hostport" == "$rest" ]]; then path=""; else path="/${rest#*/}"; fi

  host="${hostport%%:*}"
  port="${hostport#*:}"
  [[ "$port" == "$hostport" ]] && port=443

  # Drop the Solr request handler and any trailing slash.
  path="${path%/}"
  case "${path##*/}" in
    select|update|admin) path="${path%/*}" ;;
  esac
  path="${path%/}"

  local core="" context=""
  core="${path##*/}"
  local head="${path%/*}"
  context="${head##*/}"

  SRSX_EP_HOST="$host"
  SRSX_EP_PORT="$port"
  SRSX_EP_CORE="$core"
  SRSX_EP_CONTEXT="$context"
  SRSX_EP_UPDATE="https://${host}/${context}/${core}/update"
}

# Resolve a per-app SearchStax value with single-app fallback.
# ssx_app_field <k> <FIELD>  (FIELD e.g. APP_ENDPOINT, READ_TOKEN).
ssx_app_field() {
  local k="$1" field="$2" var val
  var="SEARCHSTAX_${field}_${k}"
  val="${!var:-}"
  if [[ -z "$val" && "$k" == "1" ]]; then
    var="SEARCHSTAX_${field}"
    val="${!var:-}"
  fi
  printf '%s' "$val"
}

# The SearchStax connector stores a single "Read & write token key". The write
# token is that value; fall back to the read token if only that was captured.
_ssx_update_token() {
  local k="$1" tok
  tok="$(ssx_app_field "$k" WRITE_TOKEN)"
  [[ -z "$tok" ]] && tok="$(ssx_app_field "$k" READ_TOKEN)"
  printf '%s' "$tok"
}

# True when every app (1..SEARCHSTAX_APP_COUNT) already has an endpoint.
_all_app_endpoints_set() {
  local k count="${SEARCHSTAX_APP_COUNT:-1}"
  for (( k = 1; k <= count; k++ )); do
    [[ -n "$(ssx_app_field "$k" APP_ENDPOINT)" ]] || return 1
  done
  return 0
}

# Determine SEARCHSTAX_APP_COUNT + SITE_APP_MAP for the current sites.
# Single-site → exactly one app, no questions. Idempotent: once persisted it
# returns immediately, so provision and configure never both ask.
ensure_site_app_topology() {
  if (( ${#SITES_ARR[@]} == 0 )); then
    SEARCHSTAX_APP_COUNT=1
    return 0
  fi
  if [[ -n "${SEARCHSTAX_APP_COUNT:-}" && -n "${SITE_APP_MAP:-}" ]]; then
    return 0
  fi

  local n=${#SITES_ARR[@]}
  local min_apps; min_apps="$(_ceil_div "$n" "$MAX_SITES_PER_APP")"

  printf '\n'
  info "SearchStax allows a maximum of ${MAX_SITES_PER_APP} sites per app."
  info "You are migrating ${n} site(s), so you need at least ${min_apps} app(s)."
  info "  • The default packs sites into the fewest apps (up to ${MAX_SITES_PER_APP} per app)."
  info "  • Choose more apps only if a customer wants finer separation."

  local count
  while :; do
    ask "How many SearchStax apps for these ${n} site(s)?" count "$min_apps"
    if ! [[ "$count" =~ ^[0-9]+$ ]]; then
      warn "Enter a whole number."; continue
    fi
    if (( count < min_apps )); then
      warn "At least ${min_apps} app(s) required (max ${MAX_SITES_PER_APP} sites per app)."; continue
    fi
    if (( count > n )); then
      warn "Cannot exceed the number of sites (${n})."; continue
    fi
    break
  done

  local map="" i idx
  if (( count == min_apps )); then
    # Default: pack sequentially, up to MAX_SITES_PER_APP sites per app.
    for i in "${!SITES_ARR[@]}"; do
      idx=$(( i / MAX_SITES_PER_APP + 1 ))
      map+="${SITES_ARR[$i]}=${idx},"
    done
  elif (( count == n )); then
    # One app per site.
    for i in "${!SITES_ARR[@]}"; do
      map+="${SITES_ARR[$i]}=$((i + 1)),"
    done
  else
    # Custom grouping: assign each site, then validate the partition.
    local -a assign
    while :; do
      assign=()
      local a
      for i in "${!SITES_ARR[@]}"; do
        while :; do
          ask "Which app (1-${count}) should '${SITES_ARR[$i]}' use?" a "1"
          [[ "$a" =~ ^[0-9]+$ ]] && (( a >= 1 && a <= count )) && break
          warn "Enter a number between 1 and ${count}."
        done
        assign[i]="$a"
      done
      local -a per=() ok_valid=1 j
      for a in "${assign[@]}"; do per[a]=$(( ${per[a]:-0} + 1 )); done
      for (( j = 1; j <= count; j++ )); do
        local c=${per[$j]:-0}
        if (( c < 1 )); then
          warn "App ${j} has no sites — every app must have at least one."; ok_valid=0
        elif (( c > MAX_SITES_PER_APP )); then
          warn "App ${j} has ${c} sites (max ${MAX_SITES_PER_APP})."; ok_valid=0
        fi
      done
      (( ok_valid )) && break
      info "Let's redo the assignment."
    done
    for i in "${!SITES_ARR[@]}"; do
      map+="${SITES_ARR[$i]}=${assign[$i]},"
    done
  fi
  map="${map%,}"

  SEARCHSTAX_APP_COUNT="$count"
  SITE_APP_MAP="$map"
  _save_env_var SEARCHSTAX_APP_COUNT "$count"
  _save_env_var SITE_APP_MAP "$map"
  ok "App topology: ${count} app(s) for ${n} site(s)."
}

# Persist one app's credentials (suffixed _k) and export them for this run.
# migration.env is gitignored, so secrets are safe to store here and this is
# what makes multi-app resume work across separate invocations.
_persist_app_creds() {
  local k="$1" endpoint="$2" rtok="$3" wtok="$4" aurl="$5"
  [[ -n "$endpoint" ]] && _save_env_var "SEARCHSTAX_APP_ENDPOINT_${k}" "$endpoint"
  [[ -n "$aurl"     ]] && _save_env_var "SEARCHSTAX_ANALYTICS_URL_${k}" "$aurl"
  [[ -n "$rtok"     ]] && _save_env_var "SEARCHSTAX_READ_TOKEN_${k}"   "$rtok"
  [[ -n "$wtok"     ]] && _save_env_var "SEARCHSTAX_WRITE_TOKEN_${k}"  "$wtok"
  export "SEARCHSTAX_APP_ENDPOINT_${k}=${endpoint}"
  export "SEARCHSTAX_READ_TOKEN_${k}=${rtok}"
  export "SEARCHSTAX_WRITE_TOKEN_${k}=${wtok}"
  export "SEARCHSTAX_ANALYTICS_URL_${k}=${aurl}"
  # App 1 mirrors the unsuffixed vars so single-app references keep working.
  if [[ "$k" == "1" ]]; then
    [[ -n "$endpoint" ]] && { _save_env_var SEARCHSTAX_APP_ENDPOINT "$endpoint"; export SEARCHSTAX_APP_ENDPOINT="$endpoint"; }
    [[ -n "$aurl"     ]] && { _save_env_var SEARCHSTAX_ANALYTICS_URL "$aurl"; export SEARCHSTAX_ANALYTICS_URL="$aurl"; }
    [[ -n "$rtok"     ]] && export SEARCHSTAX_READ_TOKEN="$rtok"
    [[ -n "$wtok"     ]] && export SEARCHSTAX_WRITE_TOKEN="$wtok"
  fi
  return 0
}

# ---------------------------------------------------------------------------
# Multisite step results — for per-site phases (esp. install), let a drush
# command that fails on one site NOT abort the whole run. Each step is recorded
# and, at the end of the phase, srsx_site_summary() prints a pass/fail table so
# the operator can see exactly what worked and what failed across every --uri.
# ---------------------------------------------------------------------------
declare -a SRSX_SITE_RESULTS=()   # rows: "<ok|fail>\t<site>\t<step>"
SRSX_SITE_HAD_FAILURE=0

# Reset the tracker at the start of a per-site phase.
srsx_site_results_reset() {
  SRSX_SITE_RESULTS=()
  SRSX_SITE_HAD_FAILURE=0
}

# site_step <description> <command...> — run a command for the current site,
# tolerate failure (never abort the phase), and record the outcome. Always
# returns 0 so a failing step can't trip `set -e` in the caller; inspect
# SRSX_SITE_HAD_FAILURE if you need to branch.
site_step() {
  local desc="$1"; shift
  local site="${DRUSH_URI:-default}"
  local rc=0
  "$@" || rc=$?
  if (( rc == 0 )); then
    SRSX_SITE_RESULTS+=("ok"$'\t'"${site}"$'\t'"${desc}")
    ok "${desc} — OK${DRUSH_URI:+ on ${site}}"
  else
    SRSX_SITE_RESULTS+=("fail"$'\t'"${site}"$'\t'"${desc} (exit ${rc})")
    SRSX_SITE_HAD_FAILURE=1
    warn "${desc} — FAILED (exit ${rc})${DRUSH_URI:+ on ${site}}. Continuing to the next step/site."
  fi
  return 0
}

# srsx_site_summary <phase-label> — print the collected per-site results.
# Returns non-zero if any step failed so the caller can decide whether to mark
# the phase done.
srsx_site_summary() {
  local label="$1"
  (( ${#SRSX_SITE_RESULTS[@]} == 0 )) && return 0
  info ""
  info "── ${label}: per-site results ─────────────────────────────────────────"
  local row st site step
  for row in "${SRSX_SITE_RESULTS[@]}"; do
    IFS=$'\t' read -r st site step <<< "$row"
    if [[ "$st" == "ok" ]]; then
      ok "  [${site}] ${step}"
    else
      warn "  [${site}] ${step}"
    fi
  done
  info "──────────────────────────────────────────────────────────────────────"
  if (( SRSX_SITE_HAD_FAILURE )); then
    warn "One or more steps failed above. Fix the affected site(s), then re-run"
    warn "'./srsx-migrate ${label} --force' — steps that already passed are safe to repeat."
    return 1
  fi
  return 0
}

# =============================================================================
# PHASE A — Installer / scaffolding
# =============================================================================
# (Scaffolding is install.sh's job; nothing to do here at runtime.)

# SearchStax REST API helpers (sourced here so they can use the info/warn/err/
# ok/ask/ask_secret/ask_choice/_save_env_var/state_get/state_set/STATE_DIR
# helpers defined above).
# shellcheck source=lib/searchstax_api.sh disable=SC1091
source "${SCRIPT_DIR}/lib/searchstax_api.sh"

# =============================================================================
# PHASE B — Preflight: drush status, inventory, multisite detect
# =============================================================================

phase_preflight() {
  header "preflight" "${PHASE_DESC[preflight]}"
  if phase_done_check preflight; then phase_skip_done preflight; return 0; fi

  require_cmd acli
  require_cmd composer
  require_cmd jq
  require_cmd git

  # Don't refuse prod here — preflight is read-only. Other mutating phases
  # call guard_against_prod() themselves.

  demo_sleep 0.4
  # Version/bootstrap gate. Drupal/Drush versions are codebase-wide, so a
  # single status check is enough — but under multisite a bare `drush status`
  # may not bootstrap a DB (there's often no "default" site), so target the
  # first configured --uri to get an accurate bootstrap/db-status.
  local status_json
  if (( ${#SITES_ARR[@]} > 0 )); then
    DRUSH_URI="${SITES_ARR[0]}"
  fi
  drush_capture status_json status --format=json
  DRUSH_URI=""
  if [[ -z "$status_json" ]]; then
    err "acli remote:drush returned nothing for ${ACQUIA_APP}.${EFFECTIVE_ENV}.
       Check:  acli auth:login
               acli api:applications:find
               acli remote:drush ${ACQUIA_APP}.${EFFECTIVE_ENV} -- status"
  fi

  local drupal_ver drush_ver bootstrap db
  drupal_ver=$(printf '%s' "$status_json" | jq -r '.["drupal-version"] // ""')
  drush_ver=$(printf '%s' "$status_json"  | jq -r '.["drush-version"] // ""')
  bootstrap=$(printf '%s' "$status_json"  | jq -r '.["bootstrap"] // ""')
  db=$(printf '%s' "$status_json"         | jq -r '.["db-status"] // ""')

  info "Drupal:    ${drupal_ver:-?}"
  info "Drush:     ${drush_ver:-?}"
  info "Bootstrap: ${bootstrap:-?}"
  info "DB:        ${db:-?}"

  if [[ "$drupal_ver" =~ ^7\. ]]; then
    err "Drupal 7 is not supported by this toolkit.
       Follow the SearchStax direct setup guide instead:
       https://support.searchstax.com/hc/en-us/categories/11675838621325-Site-Search"
  fi
  if [[ -n "$drush_ver" ]] && [[ "${drush_ver%%.*}" -lt 11 ]]; then
    err "Drush ${drush_ver} is too old. Drush 11+ required. Upgrade with:
       composer require --dev drush/drush:^12 -W"
  fi
  if [[ "$bootstrap" != "" && "$bootstrap" != "Successful" ]]; then
    warn "Bootstrap status: ${bootstrap}. Some phases may fail."
  fi

  ok "Drupal/Drush versions OK."

  # Inventory. In multisite each site has its OWN Search-API servers, indexes
  # and enabled modules, so the inventory must run once per --uri. The version
  # gate above is codebase-wide, so it's fine to check it a single time.
  demo_sleep 0.4
  mkdir -p "$ARTIFACTS_DIR"
  local ts; ts="$(date +%Y%m%d-%H%M%S)"
  SRSX_INV_DIR="${ARTIFACTS_DIR}/inventory-${ts}"
  mkdir -p "$SRSX_INV_DIR"

  if (( ${#SITES_ARR[@]} > 1 )); then
    info "Multisite mode: capturing inventory for ${#SITES_ARR[@]} sites: ${SITES_ARR[*]}"
  fi

  SRSX_NEEDS_INSTALL=0
  for_each_site _phase_preflight_inventory

  # module-installed is a codebase-wide optimisation hint: only claim it if
  # every site already has the searchstax module enabled.
  if [[ "${SRSX_NEEDS_INSTALL:-0}" == "0" ]]; then
    ok "searchstax module already enabled on all site(s) — install phase will be a no-op."
    state_set "module-installed" "1"
  else
    info "searchstax module missing on at least one site — install phase will add it."
  fi

  cat <<EOF

${C_BOLD}Step 8 of the Acquia preparation guide — Document your current search setup.${C_RST}
  This toolkit captures servers/indexes/modules above, but the doc also asks
  you to record (with screenshots) before continuing:
    • Apache Solr server names + index names + current item counts
    • Drupal search results views
    • Search behaviors including autocomplete settings
  Open the doc, follow step 8, then come back here to continue:
    ${PHASE_DOC[preflight]}#prerequisites

EOF
  confirm "Have you completed doc step 8 (documented current search setup)?"

  phase_done_mark preflight
}

# Capture Search-API servers/indexes/modules for the current site (honors
# DRUSH_URI set by for_each_site). Writes per-site inventory JSON files and
# flags SRSX_NEEDS_INSTALL if the searchstax module isn't enabled here.
#
# All three drush calls are read-only/diagnostic. A non-zero exit (e.g.
# search_api not yet installed on this site) must NOT abort the whole run;
# we capture what we can, warn about failures, and continue so the operator
# sees the full picture across all sites before deciding how to proceed.
_phase_preflight_inventory() {
  local servers="" indexes="" mods=""
  _drush_sapi_servers servers || {
    warn "search-api:server-list failed${DRUSH_URI:+ for ${DRUSH_URI}} (search_api may not be installed yet)"
    servers="{}"
  }
  _drush_sapi_indexes indexes || {
    warn "search-api:status failed${DRUSH_URI:+ for ${DRUSH_URI}} (no indexes configured yet?)"
    indexes="{}"
  }
  drush_capture mods pm:list --type=module --status=enabled --format=json || {
    warn "pm:list failed${DRUSH_URI:+ for ${DRUSH_URI}}"
    mods="{}"
  }

  # Per-site filename slug (safe chars only), or 'default' for single-site.
  local slug="default"
  [[ -n "$DRUSH_URI" ]] && slug="$(printf '%s' "$DRUSH_URI" | tr -c 'A-Za-z0-9._-' '_')"

  printf '%s\n' "$servers" > "${SRSX_INV_DIR}/servers-${slug}.json"
  printf '%s\n' "$indexes" > "${SRSX_INV_DIR}/indexes-${slug}.json"
  printf '%s\n' "$mods"    > "${SRSX_INV_DIR}/modules-${slug}.json"

  local n_srv n_idx
  n_srv=$(printf '%s' "$servers" | jq 'length' 2>/dev/null || echo 0)
  n_idx=$(printf '%s' "$indexes" | jq 'length' 2>/dev/null || echo 0)
  ok "Inventory${DRUSH_URI:+ for ${DRUSH_URI}}: ${n_srv} servers, ${n_idx} indexes → ${SRSX_INV_DIR}"

  # Module presence check (per site).
  if printf '%s' "$mods" | jq -e '.searchstax' >/dev/null 2>&1; then
    local ssx_ver ssx_sub
    ssx_ver="$(printf '%s' "$mods" | jq -r '.searchstax.version // "unknown"' 2>/dev/null || echo unknown)"
    ok "searchstax module already installed${DRUSH_URI:+ on ${DRUSH_URI}} (version ${ssx_ver})."
    ssx_sub="$(printf '%s' "$mods" | jq -r 'if .solr_to_searchstax_ss_migration then "enabled" else "not enabled" end' 2>/dev/null || echo unknown)"
    info "  solr_to_searchstax_ss_migration: ${ssx_sub} — this is what performs the index copy."
  else
    info "searchstax module not yet installed${DRUSH_URI:+ on ${DRUSH_URI}}."
    SRSX_NEEDS_INSTALL=1
  fi

  # Reset the tracker, (re)index, and print status for this site so the
  # baseline reflects a freshly-indexed state before migration. These are
  # intentional mutating actions per the migration runbook.
  info "Reset tracker + reindex${DRUSH_URI:+ on ${DRUSH_URI}}"
  drush sapi-rt || warn "sapi-rt failed${DRUSH_URI:+ for ${DRUSH_URI}}"
  drush sapi-i  || warn "sapi-i failed${DRUSH_URI:+ for ${DRUSH_URI}}"
  drush sapi-s  || warn "sapi-s failed${DRUSH_URI:+ for ${DRUSH_URI}}"
}

# =============================================================================
# PHASE C — Install: composer require + drush en
# =============================================================================

phase_install() {
  header "install" "${PHASE_DESC[install]}"
  if phase_done_check install; then phase_skip_done install; return 0; fi
  guard_against_prod

  cat <<EOF
This phase mirrors the Acquia walkthrough video for the install step:
  Doc:   ${PHASE_DOC[install]}
  Video: https://vimeo.com/1155060875
If this is your first migration, watch the video once before continuing —
it shows exactly what the steps below do in the Acquia UI.

It runs composer, commits and pushes a branch, waits for you to deploy it,
then enables the modules on every site. Skip it if the modules are already
installed and deployed on ${ACQUIA_APP}.${EFFECTIVE_ENV}.

EOF
  local install_choice
  ask_choice "Run the install phase now?" install_choice \
    "yes — require the modules, push, deploy, and enable them" \
    "skip — the modules are already installed and deployed"
  case "$install_choice" in
    skip*|Skip*)
      info "Skipping install. Re-run './srsx-migrate install' if the modules turn out to be missing."
      return 0
      ;;
  esac

  _ensure_tools_gitignore

  # Let the operator pin drupal/searchstax. Empty means "whatever composer
  # resolves as latest", which is what you want unless a release is known bad.
  if [[ -z "${SEARCHSTAX_MODULE_VERSION+x}" ]]; then
    ask "drupal/searchstax version (e.g. 1.12.0 or ^1.11; Enter for the latest)" \
        SEARCHSTAX_MODULE_VERSION ""
    _save_env_var SEARCHSTAX_MODULE_VERSION "$SEARCHSTAX_MODULE_VERSION"
  fi
  local ssx_require="drupal/searchstax"
  if [[ -n "${SEARCHSTAX_MODULE_VERSION:-}" ]]; then
    ssx_require="drupal/searchstax:${SEARCHSTAX_MODULE_VERSION}"
    info "Pinning ${ssx_require}"
  else
    info "Installing the latest drupal/searchstax release."
  fi

  local -a install_pkgs=(
    drupal/search_api
    drupal/search_api_solr
    drupal/searchstax
    drupal/key
  )
  local composer_rc=0
  composer_in_repo_capture require --no-interaction --no-progress \
    drupal/search_api:^1 \
    drupal/search_api_solr:^4 \
    "$ssx_require" \
    drupal/key:^1 || composer_rc=$?

  # Verify the result and report per-package status (installed / updated /
  # already present / failed). Aborts with guidance if anything is missing.
  _report_composer_result "$composer_rc" "${install_pkgs[@]}"

  ok "composer.json + composer.lock updated locally."

  # Discover git remote(s) so we can show the customer where their push will land.
  local remotes=""
  if remotes="$( cd "$REPO_ROOT" && command git remote -v 2>/dev/null )" && [[ -n "$remotes" ]]; then
    info "Detected git remote(s) for ${REPO_ROOT}:"
    printf '%s\n' "$remotes" | sed 's/^/    /'
  else
    warn "No git remotes found in ${REPO_ROOT}. Add one with 'git remote add origin <url>' before continuing."
    confirm "Continue anyway?"
  fi

  # Pick the branch the customer wants to push to (this is what Acquia will deploy).
  local default_branch
  default_branch="$( cd "$REPO_ROOT" && command git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")"
  local push_branch
  ask "Branch name to commit + push to (Acquia will auto-deploy this to ${EFFECTIVE_ENV})" \
      push_branch "$default_branch"
  [[ -n "$push_branch" ]] || err "Branch name cannot be empty."

  _stage_install_changes
  ( cd "$REPO_ROOT" && run git status --short )

  confirm "About to commit composer.json/lock + built code and push to origin/${push_branch}"
  git_commit_safe "Search: install SearchStax migration modules"
  local push_rc=0 push_out=""
  audit "git push origin ${push_branch}"
  if [[ "$DRY_RUN" != "1" ]]; then
    push_out="$( cd "$REPO_ROOT" && git push origin "$push_branch" 2>&1 )" || push_rc=$?
    [[ -n "$push_out" ]] && printf '%s\n' "$push_out"
  fi
  if (( push_rc == 0 )); then
    ok "Pushed to origin/${push_branch}."
  else
    _report_push_failure "$push_branch" "$push_out"
    # Nothing new reached the remote, so there is nothing for Acquia to deploy.
    # Asking "has it deployed yet?" next would invite a yes that is not true.
    confirm "Continue anyway? Only if '${push_branch}' reached the remote some other way"
  fi

  # Deploy is a manual step (especially on ACSF, where pushing a branch does
  # NOT auto-deploy it). Ask the operator to deploy the branch to the target
  # env via the Acquia Cloud UI, then confirm before we run drush against it.
  cat <<EOF

Deploy '${push_branch}' to ${ACQUIA_APP}.${EFFECTIVE_ENV} in the Acquia Cloud UI
now (on ACSF, pushing the branch does not auto-deploy it), and wait for the
deploy to finish before continuing.

EOF
  confirm "Has Acquia finished deploying '${push_branch}' to ${EFFECTIVE_ENV}?"

  srsx_site_results_reset
  for_each_site _phase_install_site
  if srsx_site_summary "install"; then
    phase_done_mark install
  else
    warn "Leaving 'install' un-done because at least one site failed; re-run after fixing."
  fi
}

# A rejected push is easy to scroll past, and the next thing this phase does is
# ask whether Acquia has finished deploying — so say plainly that nothing was
# pushed, and name the cause when git reported one.
_report_push_failure() {
  local branch="$1" out="$2"
  warn "git push to origin/${branch} FAILED — nothing new reached the remote."
  if [[ "$out" == *"non-fast-forward"* || "$out" == *"fetch first"* \
     || "$out" == *"behind its remote"* ]]; then
    warn "  The remote branch already has commits this checkout does not, which is what
       happens when an earlier run pushed and the local code was reverted after.
       See what is on the remote but not here:
         git -C '${REPO_ROOT}' fetch origin ${branch}
         git -C '${REPO_ROOT}' log --oneline HEAD..origin/${branch}
       Then either keep that work:
         git -C '${REPO_ROOT}' pull --rebase origin ${branch}
       or, ONLY if that branch is a disposable migration branch nobody else
       uses, replace it deliberately:
         git -C '${REPO_ROOT}' push --force-with-lease origin ${branch}"
  else
    warn "  Check the remote credentials, branch protection rules, and that the
       branch name is one you are allowed to push."
  fi
  warn "  Once the push succeeds, re-run:  ./srsx-migrate install --force"
}

_phase_install_site() {
  local site="${DRUSH_URI:-default}"
  info "${C_BOLD}Enabling SearchStax modules on ${site}${C_RST}"
  site_step "drush updb"              drush updb -y
  site_step "drush cr (pre-enable)"   drush cr
  site_step "drush en search modules" \
    drush en -y search_api search_api_solr searchstax solr_to_searchstax_ss_migration key
  site_step "drush cr (post-enable)"  drush cr
}

# =============================================================================
# PHASE D — Backup + config snapshot
# =============================================================================

phase_backup() {
  header "backup" "${PHASE_DESC[backup]}"
  if phase_done_check backup; then phase_skip_done backup; return 0; fi
  guard_against_prod

  cat <<EOF
Before mutating ${ACQUIA_APP}.${EFFECTIVE_ENV}, take an on-demand backup so you
have a clean restore point:
  1. Open the Acquia Cloud UI for ${ACQUIA_APP}.${EFFECTIVE_ENV}.
  2. Trigger an on-demand backup of the ${EFFECTIVE_ENV} database and wait for
     it to finish.

EOF

  confirm "Have you triggered an on-demand backup of the ${EFFECTIVE_ENV} DB and confirmed it finished?"

  cat <<EOF

If anything goes wrong on ${ACQUIA_APP}.${EFFECTIVE_ENV} after this point:
  1. Restore the pre-migration DB:  acli pull:db ${ACQUIA_APP}.${EFFECTIVE_ENV}
  2. Revert the migration commit:   git revert <commit> && git push
  3. Wait for your Acquia workflow to redeploy.
This toolkit does NOT ship an automated rollback — the steps above are
strictly safer and use Acquia's own tooling.

EOF

  phase_done_mark backup
}

# =============================================================================
# PHASE E1 — Provision: create the SearchStax app(s) via the REST API
# =============================================================================
#
# This phase is *optional* in practice: many customers already have an app
# provisioned by their TAM. The phase short-circuits cleanly in three cases:
#
#   1. --demo mode             — never touch the network.
#   2. All app endpoints        already set in migration.env / env.
#   3. Operator answers "no, I already have one" at the first prompt.
#
# Otherwise it logs into SearchStax (cached session in state/searchstax.session
# to avoid burning a fresh 2FA TOTP on retries), picks account/env/region,
# and creates one app per app-group determined by ensure_site_app_topology
# (subject to the 9-sites-per-app cap), POSTing to /experience-manager/v2/apps.
# For each app it GETs /apps/<id>, extracts the Solr endpoint URL + read/write
# tokens, and persists them suffixed _1.._K to migration.env (gitignored) so
# phase_configure and the per-site phases can pick them up.
#
# Resumability: each created app id is recorded to state/provisioned-app-id-<k>
# *before* the detail-fetch, so a crash between POST and GET re-uses the
# existing app instead of creating a duplicate on the next run.
phase_provision() {
  header "provision" "${PHASE_DESC[provision]}"
  if phase_done_check provision; then phase_skip_done provision; return 0; fi

  # 1. Demo mode never reaches the network. lib/demo/bin/curl is a tripwire
  #    shim that fails the build if this guard ever regresses.
  if [[ "$DEMO" == "1" ]]; then
    ok "Demo mode — skipping SearchStax API calls."
    phase_done_mark provision
    return 0
  fi

  # 2. Establish how many apps this (multi)site needs before deciding whether
  #    provisioning is required. Single-site → one app, no questions.
  ensure_site_app_topology

  # 3. Endpoint(s) already configured (previous run, TAM-provisioned app, or a
  #    standalone create-apps invocation by the operator).
  if _all_app_endpoints_set; then
    ok "App endpoint already configured. Skipping provisioning."
    info "  --force does not re-ask here; it only re-runs the phase. To correct a"
    info "  wrong endpoint or token, run:  ./srsx-migrate configure --force"
    phase_done_mark provision
    return 0
  fi

  # 4. Let the operator opt out.
  local choice
  ask_choice "Do you want srsx-migrate to create a SearchStax app for you?" choice \
    "yes — create one (or more) apps via the SearchStax REST API" \
    "no  — I already have an app; I'll paste the endpoint in 'configure'"
  case "$choice" in
    no*|No*)
      info "Skipping app creation. Make sure your endpoint + tokens are ready for the next phase."
      info "  Find them in SearchStudio → Settings → Search & Indexing / Analytics API."
      phase_done_mark provision
      return 0
      ;;
  esac

  require_cmd jq
  require_cmd curl

  if ! ssx_login; then
    warn "Continuing without creating an app."
    info "Create the app in SearchStax Studio (or ask your SearchStax contact),"
    info "then paste its endpoint and token when 'configure' asks."
    phase_done_mark provision
    return 0
  fi
  ssx_pick_account
  ssx_pick_environment
  ssx_pick_region
  ssx_pick_platform_version

  # One default app name per app (group). Single-app installs get one name.
  local -a default_names=()
  local k
  if (( ${SEARCHSTAX_APP_COUNT:-1} <= 1 )); then
    default_names+=("$(_ssx_default_app_name "")")
  else
    for (( k = 1; k <= SEARCHSTAX_APP_COUNT; k++ )); do
      default_names+=("$(_ssx_group_app_name "$k")")
    done
  fi

  # Let the operator edit each name. Re-validate after edit; if still
  # invalid, suggest a sanitised version and ask once more before erroring.
  local -a app_names=()
  local n edited suggested
  for n in "${default_names[@]}"; do
    ask "App name to create" edited "$n"
    if ! ssx_validate_name "$edited"; then
      suggested="$(printf '%s' "$edited" | tr -c 'A-Za-z0-9_' '_')"
      ask "Corrected app name" edited "$suggested"
      ssx_validate_name "$edited" || err "App name '$edited' is still invalid."
    fi
    app_names+=("$edited")
  done

  info "About to create ${#app_names[@]} SearchStax app(s) on account '$SSX_ACCOUNT' (env: $SSX_ENV, region id: $SSX_REGION_ID):"
  for n in "${app_names[@]}"; do dim "  • $n"; done
  confirm "Proceed?"

  local app_id state_key
  for (( k = 1; k <= ${#app_names[@]}; k++ )); do
    n="${app_names[$((k - 1))]}"
    state_key="provisioned-app-id-${k}"
    # Resume support: re-use an app created but not fully captured last run.
    app_id="$(state_get "$state_key")"
    if [[ -n "$app_id" ]]; then
      info "Resuming app '${n}' id '${app_id}' (created by a previous run)."
    else
      ssx_create_one_app "$n" || err "Failed to create app '$n'. Aborting."
      app_id="$ssx_last_app_id"
      [[ -n "$app_id" ]] && state_set "$state_key" "$app_id"
    fi

    if [[ -n "$app_id" ]] && ssx_wait_for_app "$app_id"; then
      _persist_app_creds "$k" "$ssx_last_endpoint" "$ssx_last_read_token" \
        "$ssx_last_write_token" "$ssx_last_analytics_url"
      ok "App ${k}/${#app_names[@]} '${n}' endpoint: ${ssx_last_endpoint}"
    else
      warn "App '${n}' created, but its endpoint URL could not be auto-extracted."
      warn "  Look it up in SearchStudio → Settings → Search & Indexing,"
      warn "  then paste it when 'configure' prompts you for app ${k}."
    fi

    rm -f "${STATE_DIR}/${state_key}"
  done

  phase_done_mark provision
}

# Derive a default app name. Server rule: 6..126 chars of [A-Za-z0-9_].
# Empty `site` means single-site.
_ssx_default_app_name() {
  local site="$1"
  local base="${ACQUIA_APP:-app}"
  local env_part="${ACQUIA_TARGET_ENV:-dev}"
  local raw
  if [[ -n "$site" && "$site" != "default" ]]; then
    raw="${base}_${site}_${env_part}"
  else
    raw="${base}_${env_part}"
  fi
  local clean
  clean="$(printf '%s' "$raw" | tr -c 'A-Za-z0-9_' '_')"
  while (( ${#clean} < 6 )); do
    clean="${clean}_"
  done
  printf '%s\n' "$clean"
}

# Default app name for app group <k>. Uses the sole site's URI when the group
# has exactly one site, otherwise base_env_appK.
_ssx_group_app_name() {
  local k="$1"
  local -a members=()
  local s
  for s in "${SITES_ARR[@]}"; do
    [[ "$(_site_app_index "$s")" == "$k" ]] && members+=("$s")
  done
  if (( ${#members[@]} == 1 )); then
    _ssx_default_app_name "${members[0]}"
    return 0
  fi
  local raw="${ACQUIA_APP:-app}_${ACQUIA_TARGET_ENV:-dev}_app${k}"
  printf '%s\n' "$(printf '%s' "$raw" | tr -c 'A-Za-z0-9_' '_')"
}

# =============================================================================
# PHASE E — Configure: prompt for SearchStax credentials
# =============================================================================

phase_configure() {
  header "configure" "${PHASE_DESC[configure]}"
  if phase_done_check configure; then phase_skip_done configure; return 0; fi
  guard_against_prod

  ensure_site_app_topology

  cat <<EOF
Where to find SearchStax credentials:
  • App endpoint URL & tokens : SearchStax Studio → Settings → Search & Indexing
  • Analytics URL & key       : SearchStax Studio → Settings → Analytics API

If you don't have an app yet, re-run './srsx-migrate provision' first — it
automates app creation via the SearchStax REST API and pre-populates the
endpoint + tokens this phase would otherwise prompt for.
EOF

  local count="${SEARCHSTAX_APP_COUNT:-1}" k
  for (( k = 1; k <= count; k++ )); do
    _configure_one_app "$k" "$count"
  done

  if [[ -z "${SECRET_STORAGE:-}" ]]; then
    ask_choice "How should the analytics key be stored?" SECRET_STORAGE \
      "key (Key module — recommended, per Acquia docs)" \
      "plain (write to searchstax.settings.analytics_key directly)"
    SECRET_STORAGE="${SECRET_STORAGE%% *}"
  fi
  _save_env_var SECRET_STORAGE "$SECRET_STORAGE"

  ok "Credentials captured for ${count} app(s) (stored in gitignored migration.env)."
  phase_done_mark configure
}

# Prompt for (or reuse) one app's credentials and persist them suffixed _k.
_configure_one_app() {
  local k="$1" count="$2"
  if (( count > 1 )); then
    printf '\n'
    info "── App ${k} of ${count} — sites: $(_sites_for_app "$k") ──"
  fi

  local ep rt wt au ak
  ep="$(ssx_app_field "$k" APP_ENDPOINT)"
  rt="$(ssx_app_field "$k" READ_TOKEN)"
  wt="$(ssx_app_field "$k" WRITE_TOKEN)"
  au="$(ssx_app_field "$k" ANALYTICS_URL)"
  ak="$(ssx_app_field "$k" ANALYTICS_KEY)"

  ask_saved "SearchStax App endpoint URL (paste the Solr URL; a trailing /select or /update is fine)" ep
  # The SearchStax connector stores one token ('update_token'); the write/read-write
  # token is that value.  A separate read-only token is not used.
  ask_saved "SearchStax read & write token" wt
  ask_saved "SearchStax analytics URL (or press Enter to skip)" au ""
  if [[ -n "$au" ]] && [[ -z "$ak" || "$FORCE" == "1" ]]; then
    ask_secret "SearchStax analytics key" ak
  fi

  # Keep rt in sync with wt so the rest of the script never reads an empty value
  # via ssx_app_field / _ssx_update_token.
  rt="$wt"

  _verify_searchstax_creds "$ep" "$wt" "$k"

  _persist_app_creds "$k" "$ep" "$rt" "$wt" "$au"
  # Show how the endpoint will be split for search_api_solr so a wrong paste is
  # obvious now rather than at 'server' time.
  if [[ -n "$ep" ]]; then
    _ssx_parse_endpoint "$ep"
    dim "  SearchStax connector: host=${SRSX_EP_HOST} context=${SRSX_EP_CONTEXT} core=${SRSX_EP_CORE}"
    dim "  Update endpoint: ${SRSX_EP_UPDATE}"
    dim "  (override in migration.env with SEARCHSTAX_SOLR_CORE_${k} / SEARCHSTAX_SOLR_CONTEXT_${k} if this is wrong)"
  fi
  # Analytics key is per-app too; persist it suffixed (and mirror app 1).
  if [[ -n "$ak" ]]; then
    _save_env_var "SEARCHSTAX_ANALYTICS_KEY_${k}" "$ak"
    export "SEARCHSTAX_ANALYTICS_KEY_${k}=${ak}"
    if [[ "$k" == "1" ]]; then export SEARCHSTAX_ANALYTICS_KEY="$ak"; fi
  fi
  return 0
}

# Verify that an endpoint URL and token can actually reach SearchStax. Hits the
# Solr /select endpoint with rows=0 and the correct Authorization header. If the
# check fails the user is offered a chance to re-enter both values rather than
# continuing with credentials that will silently fail later at 'server' time.
#
# The SearchStax connector sends: Authorization: Token <token>  (not Bearer).
# A correct response is HTTP 200 with JSON containing a "response" or "error"
# key; a 401/403 means the token is wrong; anything else likely means the URL
# is wrong.
_verify_searchstax_creds() {
  local ep="$1" tok="$2" k="$3"
  [[ "$DEMO" == "1" || "$DRY_RUN" == "1" ]] && return 0
  [[ -z "$ep" || -z "$tok" ]] && return 0

  _ssx_parse_endpoint "$ep"
  local test_url="https://${SRSX_EP_HOST}/${SRSX_EP_CONTEXT}/${SRSX_EP_CORE}/select?q=*:*&rows=0&wt=json"

  local tries=0
  while :; do
    tries=$((tries + 1))
    info "Verifying SearchStax credentials (app ${k})…"
    audit "curl -o <response> -w %{http_code} -s -S --max-time 10 -H 'Authorization: Token ***' '${test_url}'"

    local http_out http_code
    http_out="$(command curl -o - -w '\n%{http_code}' -s -S --max-time 10 \
      -H "Authorization: Token ${tok}" \
      "${test_url}" 2>&1)" || http_out="CURL_ERROR"

    if [[ "$http_out" == "CURL_ERROR" ]]; then
      http_code="CURL_ERROR"
    else
      http_code="$(printf '%s' "$http_out" | tail -1)"
    fi

    case "$http_code" in
      200)
        ok "SearchStax credentials verified (HTTP 200)."
        SRSX_VERIFY_TOKEN="$tok"
        _verify_searchstax_schema
        return 0
        ;;
      401|403)
        warn "Authentication failed (HTTP ${http_code}) — the token is likely wrong."
        ;;
      404)
        warn "HTTP 404 — the endpoint URL may be wrong (core not found)."
        info "  Parsed as: host=${SRSX_EP_HOST} context=${SRSX_EP_CONTEXT} core=${SRSX_EP_CORE}"
        info "  URL tried: ${test_url}"
        ;;
      CURL_ERROR)
        warn "Could not reach ${SRSX_EP_HOST} — check the URL and your network."
        ;;
      *)
        warn "Unexpected HTTP ${http_code} from ${SRSX_EP_HOST}."
        info "  Response: $(printf '%s' "$http_out" | head -3)"
        ;;
    esac

    if (( tries >= 3 )); then
      err "SearchStax credentials could not be verified after ${tries} attempts.
       Check the endpoint URL and token in SearchStudio, then re-run:
         ./srsx-migrate configure --force"
    fi

    local retry_choice
    ask_choice "What would you like to do?" retry_choice \
      "re-enter the endpoint URL and token and try again" \
      "continue anyway (the 'server' phase will fail later if these are wrong)"
    case "$retry_choice" in
      continue*|Continue*)
        warn "Continuing with unverified credentials."
        return 0
        ;;
    esac

    ask_saved "SearchStax App endpoint URL" ep
    ask_saved "SearchStax read & write token" tok
    _ssx_parse_endpoint "$ep"
    test_url="https://${SRSX_EP_HOST}/${SRSX_EP_CONTEXT}/${SRSX_EP_CORE}/select?q=*:*&rows=0&wt=json"
  done
}

# A reachable collection is not a usable one. search_api_solr needs its OWN
# generated config set (schema name "drupal-<version>"); a SearchStax app
# created from the stock template runs "default-config", which accepts
# documents and then cannot answer a single search_api query. Drupal reports it
# as "You are using an incompatible Solr schema", but only on the server's admin
# page — nothing in a CLI migration surfaces it, so the whole run looks green
# while search is dead.
#
# Solr's Schema API is the authority: GET <core>/schema/name.
_verify_searchstax_schema() {
  local url="https://${SRSX_EP_HOST}/${SRSX_EP_CONTEXT}/${SRSX_EP_CORE}/schema/name?wt=json"
  audit "curl -s -S --max-time 10 -H 'Authorization: Token ***' '${url}'"

  local body name
  body="$(command curl -s -S --max-time 10 \
    -H "Authorization: Token ${SRSX_VERIFY_TOKEN}" "$url" 2>&1)" || {
      warn "Could not read the Solr schema name; the solrconfig phase will re-check."
      return 0
    }
  name="$(printf '%s' "$body" | jq -r '.name // empty' 2>/dev/null || true)"

  if [[ -z "$name" ]]; then
    warn "Could not read the Solr schema name; the solrconfig phase will re-check."
    return 0
  fi
  if [[ "$name" == drupal-* ]]; then
    ok "Solr schema: ${name} — this collection has the Drupal config set."
    return 0
  fi

  warn "Solr schema is '${name}', not a Drupal config set."
  info "  The 'solrconfig' phase will generate the config set to install and will"
  info "  stop the run until the collection is running it, so nothing gets indexed"
  info "  into a collection that cannot answer a query."
  return 0
}
_save_env_var() {
  local key="$1" val="$2"
  local envfile="$ENV_FILE"
  if [[ ! -f "$envfile" ]]; then
    printf '# srsx-migrate runtime config (created %s)\n' "$(date)" > "$envfile"
  fi
  if grep -q "^${key}=" "$envfile"; then
    # Use a temp file rather than sed -i to stay portable across BSD/GNU.
    awk -v k="$key" -v v="$val" \
      'BEGIN{FS=OFS="="} $1==k{print k"=\""v"\""; next} {print}' \
      "$envfile" > "${envfile}.tmp" && mv "${envfile}.tmp" "$envfile"
  else
    printf '%s="%s"\n' "$key" "$val" >> "$envfile"
  fi
}

# _delete_env_var <key> — remove a KEY="..." line from migration.env if present.
# Used to clear stale answers (e.g. dropping SITES when the user switches a
# previously-multisite setup back to single-site).
_delete_env_var() {
  local key="$1"
  local envfile="$ENV_FILE"
  [[ -f "$envfile" ]] || return 0
  grep -q "^${key}=" "$envfile" || return 0
  awk -v k="$key" 'BEGIN{FS="="} $1==k{next} {print}' \
    "$envfile" > "${envfile}.tmp" && mv "${envfile}.tmp" "$envfile"
}

# =============================================================================
# PHASE F — Server: create the SearchStax-backed search_api server config
# =============================================================================

phase_server() {
  header "server" "${PHASE_DESC[server]}"
  if phase_done_check server; then phase_skip_done server; return 0; fi
  guard_against_prod

  _all_app_endpoints_set || \
    err "No SearchStax app endpoint configured. Run 'srsx-migrate configure' first."

  for_each_site _phase_server_site
  phase_done_mark server
}

_phase_server_site() {
  local server_id="${SRSX_NEW_SERVER_ID:-searchstax_server}"
  local tmpl="${SCRIPT_DIR}/templates/search_api.server.searchstax.yml.tmpl"
  [[ -f "$tmpl" ]] || err "Server template missing: $tmpl"

  # Resolve the SearchStax app this site routes to.
  local ai endpoint
  ai="$(_site_app_index "$DRUSH_URI")"
  endpoint="$(ssx_app_field "$ai" APP_ENDPOINT)"
  [[ -n "$endpoint" ]] || \
    err "No endpoint for app ${ai}${DRUSH_URI:+ (site ${DRUSH_URI})}. Run 'srsx-migrate configure'."

  # search_api_solr wants the endpoint split into scheme/host/port/path/core;
  # the SearchStax connector adds a 'context' and keeps the full update URL.
  # SEARCHSTAX_SOLR_CORE[_k] / SEARCHSTAX_SOLR_CONTEXT[_k] in migration.env win,
  # so an unusual endpoint layout can be corrected without a code change.
  _ssx_parse_endpoint "$endpoint"
  local ep_core ep_context
  ep_core="$(ssx_app_field "$ai" SOLR_CORE)"; ep_core="${ep_core:-$SRSX_EP_CORE}"
  ep_context="$(ssx_app_field "$ai" SOLR_CONTEXT)"; ep_context="${ep_context:-$SRSX_EP_CONTEXT}"

  local out="${ARTIFACTS_DIR}/server-${server_id}.yml"
  mkdir -p "$ARTIFACTS_DIR"
  # Written as a readable record of what was applied; the server itself is
  # created through the API so the SearchStax connector can be selected.
  sed -e "s|@@ID@@|${server_id}|g" \
      -e "s|@@NAME@@|SearchStax Cloud|g" \
      -e "s|@@HOST@@|${SRSX_EP_HOST}|g" \
      -e "s|@@PORT@@|${SRSX_EP_PORT}|g" \
      -e "s|@@CORE@@|${ep_core}|g" \
      -e "s|@@CONTEXT@@|${ep_context}|g" \
      -e "s|@@UPDATE_ENDPOINT@@|${SRSX_EP_UPDATE}|g" \
      "$tmpl" > "$out"

  info "Creating server '${server_id}' (record: ${out})"
  drush_php create-server.php \
    "SRSX_SERVER_ID=${server_id}" \
    "SRSX_SERVER_NAME=SearchStax Cloud" \
    "SRSX_HOST=${SRSX_EP_HOST}" \
    "SRSX_PORT=${SRSX_EP_PORT}" \
    "SRSX_CORE=${ep_core}" \
    "SRSX_CONTEXT=${ep_context}" \
    "SRSX_UPDATE_ENDPOINT=${SRSX_EP_UPDATE}" \
    "SRSX_UPDATE_TOKEN=$(_ssx_update_token "$ai")" \
    "SRSX_AUTOSUGGEST_ENDPOINT=$(ssx_app_field "$ai" AUTOSUGGEST_ENDPOINT)" \
    "SRSX_CONNECTOR=${SEARCHSTAX_CONNECTOR:-}"

  drush_cr
  # Verify
  local got
  drush_capture got config:get "search_api.server.${server_id}" --format=json
  if [[ "$DRY_RUN" == "0" && "$DEMO" == "0" ]]; then
    if printf '%s' "$got" | jq -e '.backend_config' >/dev/null 2>&1; then
      ok "Server search_api.server.${server_id} created and reachable."
    else
      warn "Server config did not import cleanly. Falling back to manual UI step:
        Visit /admin/config/search/solr-to-searchstax-ss-migration in the Drupal admin UI
        and follow ${PHASE_DOC[server]}"
      confirm "Once you've completed the UI migration, press Enter to continue"
    fi
  else
    ok "Server config import simulated."
  fi
}

# =============================================================================
# PHASE G — Index: clone legacy index → SearchStax-backed copy + reindex
# =============================================================================

phase_index() {
  header "index" "${PHASE_DESC[index]}"
  if phase_done_check index; then phase_skip_done index; return 0; fi
  guard_against_prod
  srsx_site_results_reset
  for_each_site _phase_index_site
  if srsx_site_summary "index"; then
    phase_done_mark index
  else
    warn "Leaving 'index' un-done because at least one site failed; re-run after fixing."
  fi
}

# The copy is made by lib/php-eval/clone-index.php, which calls the module's
# MigrationHelper::createIndexCopy() — the same method behind the "Create copy"
# button and behind `drush searchstax:copy-index`. We do NOT call that drush
# command: it only exists from searchstax 1.12.0, and even there it refuses any
# index whose current server is not in the module's migrated_servers map, which
# includes every index that has no server at all.
_phase_index_site() {
  local server_id="${SRSX_NEW_SERVER_ID:-searchstax_server}"

  if [[ "$DRY_RUN" == "1" ]]; then
    audit "drush php:script inspect-index-topology.php  # classify indexes by server"
    audit "drush php:script clone-index.php  # for each legacy index"
  else
    _phase_index_copy "$server_id" || return 0
  fi

  # Multisite: namespace each site's documents with a per-site index_prefix so
  # sites sharing one SearchStax app can filter to "this site only". Harmless
  # when a site has its own app.
  if (( ${#SITES_ARR[@]} > 0 )) && [[ -n "$DRUSH_URI" ]]; then
    local prefix; prefix="$(_ssx_site_prefix "$DRUSH_URI")"
    info "Setting index_prefix '${prefix}' for ${DRUSH_URI}"
    drush_php set-multisite-prefix.php \
      "SRSX_PREFIX=${prefix}" \
      "SRSX_SERVER_ID=${server_id}"
  fi

  drush_cr

  # Reindex whatever now sits on the SearchStax server.
  if [[ "$DRY_RUN" == "1" ]]; then
    audit "drush sapi-rt <new>; drush sapi-i <new>; drush sapi-s <new>"
  else
    local after new_ids idx
    after="$(drush_php_soft inspect-index-topology.php "SRSX_SERVER_ID=${server_id}")" || after=""
    new_ids="$(awk -F'\t' '$1=="[srsx-index]" && $2=="target"{print $3}' <<<"$after")"
    if [[ -z "$new_ids" ]]; then
      _srsx_site_fail "no index on '${server_id}' after copying"
      warn "Nothing is on '${server_id}', so there is nothing to index."
      warn "Run './srsx-migrate doctor' to see what each index is actually attached to."
      return 0
    fi
    local -a new_arr=()
    while IFS= read -r idx; do
      [[ -n "$idx" ]] && new_arr+=("$idx")
    done <<< "$new_ids"
    for idx in "${new_arr[@]}"; do
      info "Reindexing: ${idx}"
      # Clear first: anything already in the collection was written under
      # whatever schema was live at the time, and a reindex overwrites by
      # document ID rather than removing what no longer matches.
      drush sapi-c "$idx"
      drush sapi-rt "$idx"
      drush sapi-i "$idx"
      drush sapi-s "$idx"
    done
  fi

  ok "Index copy + reindex complete."
}

# Classify every index on this site and copy the ones that belong on SearchStax.
# Returns non-zero when the site cannot proceed (module missing, no target
# server, no indexes).
#
# The classification comes from inspect-index-topology.php, not from
# `search-api:list --format=json`: that command's default field set omits the
# machine-readable `server` column entirely (it ships `serverName`, a human
# label), so every index came back looking detached.
_phase_index_copy() {
  local server_id="$1"

  _ensure_migration_module || return 1

  local topology
  topology="$(drush_php_soft inspect-index-topology.php "SRSX_SERVER_ID=${server_id}")" || {
    _srsx_site_fail "could not read the Search-API topology"
    return 1
  }
  # Shown as well as parsed, so the run stays readable.
  grep -v '^\[srsx-' <<<"$topology" || true

  _phase_index_check_target "$server_id" "$topology" || return 1

  # awk, not sed: BSD sed does not read \t as a tab in a regex.
  local classified
  classified="$(awk -F'\t' -v OFS='\t' '$1=="[srsx-index]"{print $2,$3,$4,$5}' <<<"$topology")"
  if [[ -z "$classified" ]]; then
    _srsx_site_fail "no Search API indexes on this site"
    warn "This site has no Search API indexes at all, so there is nothing to copy."
    info "  Create one first (Search API → Add index), point it at the legacy"
    info "  Solr server, then re-run:  ./srsx-migrate index --force"
    return 1
  fi

  # Collected into an array before acting on it. `acli` reads stdin, so running
  # it inside `while read ... <<< "$list"` swallows the remaining lines and the
  # loop silently stops after the first item that touches the environment.
  local -a rows=()
  local row
  while IFS= read -r row; do
    [[ -n "$row" ]] && rows+=("$row")
  done <<< "$classified"

  local cls idx srv backend copied=0
  for row in "${rows[@]}"; do
    IFS=$'\t' read -r cls idx srv backend <<< "$row"
    [[ -z "$idx" ]] && continue
    case "$cls" in
      target)
        info "Already on '${server_id}': ${idx}"
        ;;
      legacy)
        site_step "copy index '${idx}' (from ${srv})" \
          drush_php_soft clone-index.php "SRSX_INDEX_ID=${idx}" "SRSX_NEW_SERVER_ID=${server_id}"
        copied=1
        ;;
      other)
        info "Skipping '${idx}': its server '${srv}' is a ${backend:-non-Solr} backend, not Acquia Search."
        info "  Moving it to SearchStax is a product decision, not part of this migration."
        info "  To move it anyway:  SRSX_COPY_INDEXES='${idx}' ./srsx-migrate index --force"
        ;;
      *)
        info "Skipping '${idx}': it is not attached to any server."
        info "  An index with no server was never serving search."
        info "  To move it anyway:  SRSX_COPY_INDEXES='${idx}' ./srsx-migrate index --force"
        ;;
    esac
  done

  # Explicit opt-in for anything the classifier declined to move on its own.
  local -a forced_ids=()
  read -r -a forced_ids <<< "${SRSX_COPY_INDEXES:-}"
  local forced forced_cls
  for forced in "${forced_ids[@]}"; do
    forced_cls="$(awk -F'\t' -v id="$forced" '$2==id{print $1}' <<<"$classified")"
    case "$forced_cls" in
      "")
        warn "SRSX_COPY_INDEXES names '${forced}', which does not exist on this site."
        ;;
      legacy|target)
        ;;
      *)
        site_step "copy index '${forced}' (forced, ${forced_cls})" \
          drush_php_soft clone-index.php "SRSX_INDEX_ID=${forced}" "SRSX_NEW_SERVER_ID=${server_id}"
        copied=1
        ;;
    esac
  done

  if (( copied == 0 )); then
    _srsx_site_fail "no index was eligible to copy"
    warn "No index was copied on this site."
    return 1
  fi
  return 0
}

# The target server has to exist and actually be SearchStax-backed: a copy made
# onto a missing or misconfigured server produces an index that indexes nowhere.
_phase_index_check_target() {
  local server_id="$1" topology="$2"
  local state="" connector=""
  IFS=$'\t' read -r state _ connector \
    < <(awk -F'\t' -v OFS='\t' '$1=="[srsx-target]"{print $2,$3,$4}' <<<"$topology") || true

  case "$state" in
    ok) _phase_index_check_schema || return 1; return 0 ;;
    missing)
      _srsx_site_fail "search server '${server_id}' does not exist"
      warn "There is no '${server_id}' server on this site, so there is nothing to copy onto."
      warn "  Create it first, then re-run:"
      warn "    ./srsx-migrate server --force"
      warn "    ./srsx-migrate index --force"
      ;;
    not-solr)
      _srsx_site_fail "search server '${server_id}' is not a Solr server"
      warn "'${server_id}' exists but does not use the search_api_solr backend."
      warn "  Re-create it with:  ./srsx-migrate server --force"
      ;;
    wrong-connector)
      _srsx_site_fail "search server '${server_id}' uses the '${connector}' connector"
      warn "'${server_id}' uses the '${connector}' Solr connector, not the SearchStax one."
      warn "  A server built this way never reaches SearchStax, so copying onto it"
      warn "  would look like success and index nothing. Re-create it with:"
      warn "    ./srsx-migrate server --force"
      ;;
    *)
      _srsx_site_fail "could not determine the state of '${server_id}'"
      warn "The topology report did not say whether '${server_id}' is usable."
      ;;
  esac
  return 1
}

# The copy helper lives in solr_to_searchstax_ss_migration; without it we fall
# back to hand-rolled config surgery that cannot record the old→new mapping the
# 'views' phase reads, so enable it here rather than discover that later.
_ensure_migration_module() {
  local mods="{}"
  drush_capture mods pm:list --type=module --status=enabled --format=json || mods="{}"
  if printf '%s' "$mods" | jq -e '.solr_to_searchstax_ss_migration' >/dev/null 2>&1; then
    return 0
  fi
  warn "solr_to_searchstax_ss_migration is not enabled${DRUSH_URI:+ on ${DRUSH_URI}} — enabling it."
  if drush en -y solr_to_searchstax_ss_migration; then
    return 0
  fi
  _srsx_site_fail "could not enable solr_to_searchstax_ss_migration"
  warn "Copies made without it cannot record the old→new index mapping that the"
  warn "'views' phase depends on. Fix the module install and re-run:"
  warn "  ./srsx-migrate index --force"
  return 1
}

# Documents written against the stock "default-config" schema are unreadable by
# every search_api query, and the indexed count still reports 100% because it
# comes from Drupal's tracker. Refuse rather than manufacture that state.
_phase_index_check_schema() {
  [[ "$DEMO" == "1" || "$DRY_RUN" == "1" ]] && return 0
  local ai name
  ai="$(_site_app_index "${DRUSH_URI:-}")"
  if ! name="$(_ssx_solr_schema_name "$ai")"; then
    warn "Could not read the Solr schema name; continuing without that check."
    return 0
  fi
  if [[ "$name" == drupal-* ]]; then
    return 0
  fi
  _srsx_site_fail "collection runs '${name}', not a Drupal config set"
  warn "The SearchStax collection is running '${name}'."
  warn "  Indexing onto it would report success and leave search returning nothing."
  warn "  Run './srsx-migrate solrconfig --force' and follow what it prints."
  return 1
}

# Record a per-site failure without running a command (site_step wraps commands).
_srsx_site_fail() {
  SRSX_SITE_RESULTS+=("fail"$'\t'"${DRUSH_URI:-default}"$'\t'"$1")
  SRSX_SITE_HAD_FAILURE=1
}

# =============================================================================
# PHASE H — Views: switch every Search-API view to its new index
# =============================================================================

phase_views() {
  header "views" "${PHASE_DESC[views]}"
  if phase_done_check views; then phase_skip_done views; return 0; fi
  guard_against_prod
  srsx_site_results_reset
  for_each_site _phase_views_site
  if srsx_site_summary "views"; then
    phase_done_mark views
  else
    warn "Leaving 'views' un-done because at least one site failed; re-run after fixing."
  fi
}

_phase_views_site() {
  local server_id="${SRSX_NEW_SERVER_ID:-searchstax_server}"

  if [[ "$DRY_RUN" == "1" ]]; then
    audit "drush php:script switch-view-index.php  # for each migrated view"
    drush_cr
    ok "Views switched to SearchStax-backed indexes."
    return 0
  fi

  if [[ -n "${SRSX_ROLLBACK_VIEWS:-}" ]]; then
    _phase_views_rollback
    return 0
  fi

  # Ask the site which views still point at a copied index. The module records
  # the original → copy mapping itself, so we do not have to guess index names.
  local views_out
  if ! views_out="$(drush_php_soft list-migrated-views.php "SRSX_SERVER_ID=${server_id}")"; then
    [[ -n "$views_out" ]] && grep -v '^\[srsx-' <<<"$views_out"
    _srsx_site_fail "no index copy is recorded, so no view can be switched"
    warn "Run './srsx-migrate index --force' until it reports a copy, then re-run this phase."
    return 0
  fi
  grep -v '^\[srsx-' <<<"$views_out" || true

  # Collected into an array before acting on it. `acli` reads stdin, so running
  # it inside `while read ... <<< "$list"` swallows the remaining lines and the
  # loop silently stops after the first view.
  local -a views=()
  local view
  while IFS= read -r view; do
    [[ -n "$view" ]] && views+=("$view")
  done <<< "$(awk -F'\t' '$1=="[srsx-view]"{print $2}' <<<"$views_out")"

  if (( ${#views[@]} == 0 )); then
    warn "Indexes were copied, but no view is bound to any of them — nothing to switch here."
    return 0
  fi

  # A view's index is decided by its base_table, and the report above prints it
  # for every Search API view. If only some of them should move, name them.
  if [[ -n "${SRSX_SWITCH_VIEWS:-}" ]]; then
    local -a wanted=() kept=()
    read -r -a wanted <<< "$SRSX_SWITCH_VIEWS"
    local w
    for view in "${views[@]}"; do
      for w in "${wanted[@]}"; do
        [[ "$view" == "$w" ]] && kept+=("$view") && break
      done
    done
    info "SRSX_SWITCH_VIEWS is set: switching ${#kept[@]} of ${#views[@]} view(s)."
    views=("${kept[@]}")
    if (( ${#views[@]} == 0 )); then
      warn "None of the views named in SRSX_SWITCH_VIEWS is bound to a copied index."
      return 0
    fi
  fi

  # switch-view-index.php calls the same MigrationHelper methods as
  # `drush searchstax:switch-view-index`, which only exists from 1.12.0, and
  # rewrites the view itself on releases that have no such service.
  local before_failure="$SRSX_SITE_HAD_FAILURE"
  for view in "${views[@]}"; do
    site_step "switch view '${view}'" \
      drush_php_soft switch-view-index.php "SRSX_VIEW_ID=${view}"
  done

  drush_cr
  if [[ "$SRSX_SITE_HAD_FAILURE" == "$before_failure" ]]; then
    ok "Switched ${#views[@]} view(s) to SearchStax-backed indexes."
  else
    warn "Some views could not be switched${DRUSH_URI:+ on ${DRUSH_URI}} — see the summary below."
  fi
}

# Put named views back on the index they were on before the migration touched
# them. Only views this toolkit switched can be rolled back: the original table
# comes from the module's own record, written at switch time.
_phase_views_rollback() {
  local -a wanted=()
  read -r -a wanted <<< "$SRSX_ROLLBACK_VIEWS"
  info "${C_BOLD}Rolling back ${#wanted[@]} view(s) to their original index${C_RST}"

  local before_failure="$SRSX_SITE_HAD_FAILURE"
  local view
  for view in "${wanted[@]}"; do
    site_step "roll back view '${view}'" \
      drush_php_soft switch-view-index.php "SRSX_VIEW_ID=${view}" "SRSX_ROLLBACK=1"
  done

  drush_cr
  if [[ "$SRSX_SITE_HAD_FAILURE" == "$before_failure" ]]; then
    ok "Rolled back ${#wanted[@]} view(s)."
    info "  Unset SRSX_ROLLBACK_VIEWS before running the views phase normally again."
  else
    warn "Some views could not be rolled back${DRUSH_URI:+ on ${DRUSH_URI}} — see the summary below."
  fi
}

# =============================================================================
# PHASE I — Route: enable SearchStudio + analytics
# =============================================================================

phase_route() {
  header "route" "${PHASE_DESC[route]}"
  if phase_done_check route; then phase_skip_done route; return 0; fi
  guard_against_prod
  for_each_site _phase_route_site
  phase_done_mark route
}

_phase_route_site() {
  # Resolve the SearchStax app this site routes to.
  local ai analytics_url analytics_key
  ai="$(_site_app_index "$DRUSH_URI")"
  analytics_url="$(ssx_app_field "$ai" ANALYTICS_URL)"
  analytics_key="$(ssx_app_field "$ai" ANALYTICS_KEY)"

  # Verified config keys from searchstax.schema.yml.
  drush cset -y searchstax.settings searches_via_searchstudio 1
  drush cset -y searchstax.settings configure_via_searchstudio 0

  if [[ -n "$analytics_url" ]]; then
    drush cset -y searchstax.settings analytics_url "${analytics_url}"
  fi

  if [[ -n "$analytics_key" ]]; then
    case "${SECRET_STORAGE:-key}" in
      key)
        info "Storing analytics key as a Key module entity"
        drush_php create-key-entity.php "SRSX_KEY_VALUE=${analytics_key}"
        drush cset -y searchstax.settings key_id "searchstax_analytics_key"
        ;;
      plain)
        warn "Storing analytics key as plain config (NOT recommended for prod)"
        drush cset -y searchstax.settings analytics_key "${analytics_key}"
        ;;
      *)
        err "Unknown SECRET_STORAGE: ${SECRET_STORAGE}"
        ;;
    esac
  fi

  drush_cr
  ok "SearchStudio routing enabled${DRUSH_URI:+ on ${DRUSH_URI}}."
}

# =============================================================================
# PHASE K — Validate: server URL, item counts, view bindings
# =============================================================================

phase_validate() {
  header "validate" "${PHASE_DESC[validate]}"
  # validate is read-only, so it does NOT call guard_against_prod — it's the
  # one phase that's safe to run against any env (including prod) via
  # `./srsx-migrate validate --env prod`.
  for_each_site _phase_validate_site
  if [[ "${SRSX_VALIDATE_FAIL:-0}" -gt 0 ]]; then
    err "Validation failed: ${SRSX_VALIDATE_FAIL} issue(s). See log: ${LOG_FILE}"
  fi
  ok "All validation checks passed on ${ACQUIA_APP}.${EFFECTIVE_ENV}."
  # Don't write done-validate marker when checking a non-default env, so the
  # default-env validate marker isn't poisoned by a prod check.
  if [[ "$EFFECTIVE_ENV" == "$ACQUIA_TARGET_ENV" ]]; then
    phase_done_mark validate
  fi
}

SRSX_VALIDATE_FAIL=0
_phase_validate_site() {
  local servers indexes views
  _drush_sapi_servers servers
  _drush_sapi_indexes indexes

  _validate_solr_schema

  # Server URL must contain searchstax.com.
  local hosts
  hosts=$(printf '%s' "$servers" \
    | jq -r '.[].backend_config.connector_config.host // .[].backend_config.host // empty' \
    2>/dev/null || true)
  if [[ -n "$hosts" ]] && ! grep -q "searchstax.com" <<<"$hosts"; then
    warn "No server host contains 'searchstax.com' (${hosts})"
    SRSX_VALIDATE_FAIL=$((SRSX_VALIDATE_FAIL+1))
  else
    ok "Server hosts contain searchstax.com"
  fi

  # Each searchstax-backed index must have count > 0.
  local rows
  rows=$(printf '%s' "$indexes" \
    | jq -r 'to_entries[] | select(.value.server | startswith("searchstax")) | "\(.key) \(.value.count // 0)"' \
    2>/dev/null || true)
  while IFS=' ' read -r idx cnt; do
    [[ -z "$idx" ]] && continue
    if [[ "$cnt" =~ ^[0-9]+$ ]] && (( cnt > 0 )); then
      ok "Index ${idx}: ${cnt} items"
    else
      warn "Index ${idx}: 0 items — indexing not complete"
      SRSX_VALIDATE_FAIL=$((SRSX_VALIDATE_FAIL+1))
    fi
  done <<< "$rows"
}

# Indexed item counts come from Drupal's tracker, not from Solr, so they read
# 100% even when the collection cannot answer a query. Ask Solr what schema it
# is actually running.
_validate_solr_schema() {
  [[ "$DEMO" == "1" || "$DRY_RUN" == "1" ]] && return 0
  local ai name
  ai="$(_site_app_index "${DRUSH_URI:-}")"
  if ! name="$(_ssx_solr_schema_name "$ai")"; then
    warn "Could not read the Solr schema name."
    return 0
  fi

  if [[ "$name" == drupal-* ]]; then
    ok "Solr schema: ${name}"
  else
    warn "Solr schema is '${name}', not a Drupal config set — search cannot work."
    warn "  Run './srsx-migrate solrconfig --force' and follow what it prints."
    SRSX_VALIDATE_FAIL=$((SRSX_VALIDATE_FAIL+1))
  fi
}

# =============================================================================
# PHASE M — Handoff: pull config from target env, stage git changes,
#            then HAND OFF promotion to the customer's CI/CD.
#            This phase does NOT git commit and NOT git push.
# =============================================================================

# Detect which directory in the local repo holds Drupal's config sync YAMLs.
_detect_config_dir() {
  local d
  for d in config/sync config/default config docroot/sites/default/config web/sites/default/config; do
    if [[ -d "${REPO_ROOT}/${d}" ]]; then
      printf '%s' "$d"
      return 0
    fi
  done
  return 1
}

phase_handoff() {
  header "handoff" "${PHASE_DESC[handoff]}"
  if phase_done_check handoff; then phase_skip_done handoff; return 0; fi
  guard_against_prod

  cat <<EOF

This phase exports the SearchStax config from ${ACQUIA_APP}.${EFFECTIVE_ENV},
pulls it to your local repo, and stages it for commit. It does NOT commit or
push — you review the diff first.

If you would rather commit the config manually (e.g. the export already happened
a previous time, or you prefer to do it from a different shell), skip this phase.

EOF
  local choice
  ask_choice "Do you want to run the handoff export now?" choice \
    "yes — export config from ${ACQUIA_APP}.${EFFECTIVE_ENV} and stage it locally" \
    "skip — I will handle the config export and commit manually"
  case "$choice" in
    skip*|Skip*)
      info "Skipping handoff. When ready, run: ./srsx-migrate handoff"
      info "  Or manually:  drush --uri=<site> config:export && git add <config_dir> && git commit"
      return 0
      ;;
  esac

  local config_dir
  if ! config_dir="$(_detect_config_dir)"; then
    err "No Drupal config sync directory found in ${REPO_ROOT}.
       Looked for: config/sync, config/default, config, docroot/sites/default/config, web/sites/default/config
       Create one (e.g. 'mkdir -p config/sync') and re-run."
  fi
  info "Local config sync dir: ${config_dir}"

  local ts; ts="$(date +%Y%m%d-%H%M%S)"
  local remote_dir="/tmp/srsx-handoff-${ts}"

  info "Exporting config on ${ACQUIA_APP}.${EFFECTIVE_ENV} → ${remote_dir}"
  drush cex --destination="$remote_dir" -y

  info "Pulling config to ${REPO_ROOT}/${config_dir}"
  if [[ "$DRY_RUN" == "1" ]]; then
    audit "acli ssh ${ACQUIA_APP}.${EFFECTIVE_ENV} -- 'cd ${remote_dir} && tar -cf - .' | tar -xf - -C ${REPO_ROOT}/${config_dir}"
  elif [[ "$DEMO" == "1" ]]; then
    # Demo: copy fixture if available, else just touch a marker.
    if [[ -d "${SRSX_DEMO_FIXTURES:-}/handoff-config" ]]; then
      cp -R "${SRSX_DEMO_FIXTURES}/handoff-config/." "${REPO_ROOT}/${config_dir}/"
    else
      printf 'demo: 1\n' > "${REPO_ROOT}/${config_dir}/srsx.demo.yml"
    fi
  else
    acli ssh "${ACQUIA_APP}.${EFFECTIVE_ENV}" -- "cd '${remote_dir}' && tar -cf - ." \
      | tar -xf - -C "${REPO_ROOT}/${config_dir}"
  fi

  ( cd "$REPO_ROOT" && run git add composer.json composer.lock 2>/dev/null || true )
  ( cd "$REPO_ROOT" && run git add "$config_dir" )
  ( cd "$REPO_ROOT" && run git status --short )

  # Multisite caveat: `drush cex` above exported only the default site's config.
  # Each additional site keeps its own config (separate DB + config_sync_directory)
  # and must be exported per --uri before deploy. Automating this is a planned
  # follow-up; for now we surface explicit manual steps.
  if (( ${#SITES_ARR[@]} > 0 )); then
    warn "Multisite detected: the export above covered only the default site."
    info "  Export each remaining site's config into its own config sync directory:"
    local s
    for s in "${SITES_ARR[@]}"; do
      [[ -z "$s" || "$s" == "default" ]] && continue
      info "    acli remote:drush ${ACQUIA_APP}.${EFFECTIVE_ENV} -- --uri=${s} config:export -y"
      info "      → pull that site's YAML into its config_sync_directory, then git add it."
    done
    info "  (Each site's search_api.server/index + views config must be committed"
    info "   for its SearchStax app to take effect after deploy.)"
  fi

  cat <<EOF

─────────────────────────────────────────────────────────────
  Migration validated on ${ACQUIA_APP}.${EFFECTIVE_ENV}.

  Next steps to take this live:

    1. Review the staged changes:    git diff --staged
    2. Commit:                       git commit -m "Search: migrate to SearchStax"
    3. Push your migration branch:   git push origin <branch>
    4. Deploy to higher environments through your normal Acquia workflow
       (e.g. promote the code/config from dev → stage → prod).
    5. After the prod deploy, run your standard smoke tests.
    6. (Recommended) re-run validation against prod — read-only:
         ./srsx-migrate validate --env prod
─────────────────────────────────────────────────────────────
EOF
  phase_done_mark handoff
}

# =============================================================================
# PHASE N — Cleanup: uninstall migration submodule + remove legacy
# =============================================================================

phase_cleanup() {
  header "cleanup" "${PHASE_DESC[cleanup]}"
  if phase_done_check cleanup; then phase_skip_done cleanup; return 0; fi
  guard_against_prod
  warn "Only run this after Phase 'validate' passes in PRODUCTION."
  confirm "Proceed with legacy removal on ${ACQUIA_APP}.${EFFECTIVE_ENV}?"

  for_each_site _phase_cleanup_site

  # Composer remove (with safety guard).
  if [[ "${KEEP_ACQUIA_SEARCH_IN_COMPOSER:-0}" == "1" ]]; then
    warn "KEEP_ACQUIA_SEARCH_IN_COMPOSER=1 — leaving acquia_search in composer.json."
  else
    composer_in_repo remove --no-interaction drupal/acquia_search 2>/dev/null || \
      warn "composer remove drupal/acquia_search failed (already gone?)"
    composer_in_repo remove --no-interaction drupal/acquia_connector 2>/dev/null || \
      warn "composer remove drupal/acquia_connector failed (already gone?)"
  fi

  composer_in_repo remove --no-interaction drupal/searchstax_solr_migration 2>/dev/null || true

  ok "Cleanup complete. Commit + deploy, then delete the legacy Solr index from the Acquia Cloud UI."
  phase_done_mark cleanup
}

_phase_cleanup_site() {
  drush pmu -y solr_to_searchstax_ss_migration 2>/dev/null || \
    warn "Could not uninstall solr_to_searchstax_ss_migration (already gone?)"
  drush pmu -y acquia_search 2>/dev/null || \
    warn "Could not uninstall acquia_search"
  drush pmu -y acquia_connector 2>/dev/null || \
    warn "Could not uninstall acquia_connector"
  drush cex -y
}

