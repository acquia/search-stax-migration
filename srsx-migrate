  for_each_site _doctor_site
  info ""
  info "How to read the report:"
  info "  • [legacy]   on a non-SearchStax Solr server → the index phase copies it."
  info "  • [target]   already on the SearchStax server → nothing to do."
  info "  • [other]    on a database (or other non-Solr) server → left alone; moving"
  info "               it to SearchStax is a product decision, not a migration step."
  info "  • [detached] no server at all → left alone; it was never serving search."
  info "  Force either of the last two with:  SRSX_COPY_INDEXES='<id> <id>'"
  info ""
  info "  A view's index comes from its base_table, which no display can override,"
  info "  so the view list above shows the index, server and backend behind each"
  info "  one. Views whose backend is search_api_db are database search and are"
  info "  left alone. Restrict the switch set with:  SRSX_SWITCH_VIEWS='<id> <id>'"
  info ""
  info "  server(entity) vs server(raw config) differing means a config override"
  info "  supplies the server, so drush and the web UI see different topologies."
  info "  An empty migrated_servers map only affects the module's own UI form —"
  info "  this toolkit copies through the service directly and does not need it."
}

_doctor_site() {
  drush_php_soft inspect-index-topology.php \
      "SRSX_SERVER_ID=${SRSX_NEW_SERVER_ID:-searchstax_server}" \
    | grep -v '^\[srsx-' \
