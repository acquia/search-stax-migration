}

# =============================================================================
# SOLRCONFIG — the Solr config set the SearchStax collection must run
# =============================================================================
#
# search_api_solr generates its own schema and solrconfig, and the searchstax
# module injects the SearchStudio request handlers into them via
# hook_search_api_solr_config_files_alter(). A collection created from the stock
# template runs "default-config" instead, which accepts every document Drupal
# pushes and then answers no search_api query — indexing reports 100% and search
# returns nothing.
#
# Drupal cannot push a config set to a hosted collection, so this phase
# generates it, checks what the collection is actually running, and refuses to
# let the run continue while the two disagree.

# Echo the schema name Solr reports for app <k>, or nothing if it cannot be read.
# Solr's Schema API is the authority; Drupal's indexed counts are not, because
# they come from its own tracker rather than from Solr.
_ssx_solr_schema_name() {
  local k="$1" ep tok
  ep="$(ssx_app_field "$k" APP_ENDPOINT)"
  tok="$(_ssx_update_token "$k")"
  [[ -z "$ep" || -z "$tok" ]] && return 1

  _ssx_parse_endpoint "$ep"
  local body
  body="$(command curl -s -S --max-time 10 -H "Authorization: Token ${tok}" \
    "https://${SRSX_EP_HOST}/${SRSX_EP_CONTEXT}/${SRSX_EP_CORE}/schema/name?wt=json" 2>&1)" \
    || return 1
  local name
  name="$(printf '%s' "$body" | jq -r '.name // empty' 2>/dev/null || true)"
  [[ -n "$name" ]] || return 1
  printf '%s' "$name"
}

phase_solrconfig() {
  header "solrconfig" "${PHASE_DESC[solrconfig]}"
  if phase_done_check solrconfig; then phase_skip_done solrconfig; return 0; fi
  guard_against_prod

  SRSX_SOLRCONFIG_ROOT="${ARTIFACTS_DIR}/solr-config"
  mkdir -p "$SRSX_SOLRCONFIG_ROOT"
  srsx_site_results_reset
  for_each_site _phase_solrconfig_site
  if srsx_site_summary "solrconfig"; then
    phase_done_mark solrconfig
    return 0
  fi

  cat <<EOF

─────────────────────────────────────────────────────────────
  ${C_BOLD}The migration stops here on purpose.${C_RST}

  Indexing against a collection that is not set up for Drupal produces
  documents no search can read, while every phase reports success.

  The SearchStax app could not be configured automatically, so the config
  set has been written to
    ${SRSX_SOLRCONFIG_ROOT}
  Send it to SearchStax and ask them to install it on the collection,
  reload the collection, and set
    SOLR_MODULES="extraction,langid,ltr,analysis-extras"

  Then re-run:
    ./srsx-migrate solrconfig --force
  which re-checks the collection and, once it passes, continues the run.
─────────────────────────────────────────────────────────────
EOF
  err "The SearchStax collection is not set up for Drupal yet."
}

_phase_solrconfig_site() {
  local server_id="${SRSX_NEW_SERVER_ID:-searchstax_server}"
  local ai; ai="$(_site_app_index "${DRUSH_URI:-}")"
  local slug="default"
  [[ -n "$DRUSH_URI" ]] && slug="$(printf '%s' "$DRUSH_URI" | tr -c 'A-Za-z0-9._-' '_')"

  if [[ "$DRY_RUN" == "1" || "$DEMO" == "1" ]]; then
    audit "drush php:script searchstax-configure-app.php  # set the app's languages"
    audit "curl <core>/schema/name  # verify the collection was rebuilt"
    ok "SearchStax app configured and schema verified (demo)."
    return 0
  fi

  local name
  name="$(_ssx_solr_schema_name "$ai")" || name=""
  if [[ "$name" == drupal-* ]]; then
    ok "Collection schema: ${name} — already set up for Drupal."
    return 0
  fi

  info "Collection schema is '${name:-unreadable}' — configuring the app through the SearchStax API."
  if _solrconfig_configure_app "$server_id"; then
    name="$(_ssx_wait_for_schema "$ai")" || name=""
    if [[ "$name" == drupal-* ]]; then
      ok "Collection schema: ${name} — SearchStax rebuilt the collection."
      return 0
    fi
    warn "SearchStax accepted the configuration but the collection still reports '${name:-unreadable}'."
  fi

  # Either there was no login, the API refused, or the rebuild did not land.
  # Produce the config set so it can be handed over instead.
  _solrconfig_generate "$server_id" "$slug"
  _srsx_site_fail "collection runs '${name:-unreadable}', not a Drupal config set"
  warn "Collection schema is '${name:-unreadable}'${DRUSH_URI:+ for ${DRUSH_URI}}."
  warn "  Drupal will report 'You are using an incompatible Solr schema' and every"
  warn "  search will return nothing, however many documents get indexed."
  return 0
}

# Drive the searchstax module's own API client to configure the app.
#
# The module keeps its own SearchStax session for 24 hours, so try that first:
# a site whose admin has logged in through the Drupal UI, or that a previous run
# authenticated, needs no login here at all. Only when it reports NO_SESSION do
# we ask for one, and even then our login helper reuses its cached session.
_solrconfig_configure_app() {
  local server_id="$1" out=""

  out="$(drush_php_soft searchstax-configure-app.php \
    "SRSX_SERVER_ID=${server_id}" \
    "SRSX_ACCOUNT=${SSX_ACCOUNT:-}" \
    "SRSX_APP_ID=${SEARCHSTAX_APP_ID:-}" 2>&1)" || true
  printf '%s\n' "$out"
  if [[ "$out" != *NO_SESSION* ]]; then
    # Either it worked, or it failed for a reason a login would not fix.
    [[ "$out" == *"[searchstax-configure-app] OK"* ]] && return 0
    return 1
  fi

  info "The site has no SearchStax session, so one is needed to configure the app."
  if [[ -z "${SSX_TOKEN:-}" ]]; then
    ssx_session_load >/dev/null 2>&1 || true
  fi
  if [[ -z "${SSX_TOKEN:-}" ]]; then
    local choice
    ask_choice "Log in to SearchStax now so srsx-migrate can configure the app?" choice \
      "yes — log in and configure the app automatically" \
      "no  — I will send the config set to SearchStax myself"
    case "$choice" in
      no*|No*) return 1 ;;
    esac
    require_cmd jq
    require_cmd curl
    ssx_login || { warn "SearchStax login failed."; return 1; }
  fi

  out="$(drush_php_soft searchstax-configure-app.php \
    "SRSX_SSX_TOKEN=${SSX_TOKEN}" \
    "SRSX_SERVER_ID=${server_id}" \
    "SRSX_ACCOUNT=${SSX_ACCOUNT:-}" \
    "SRSX_APP_ID=${SEARCHSTAX_APP_ID:-}" 2>&1)" || true
  printf '%s\n' "$out"
  [[ "$out" == *"[searchstax-configure-app] OK"* ]]
}

# SearchStax rebuilds the collection asynchronously after a language change, so
# the schema does not flip on the next request. Poll briefly before giving up.
_ssx_wait_for_schema() {
  local k="$1" name="" i
  for i in 1 2 3 4 5 6; do
    name="$(_ssx_solr_schema_name "$k")" || name=""
    [[ "$name" == drupal-* ]] && { printf '%s' "$name"; return 0; }
    info "  waiting for SearchStax to rebuild the collection (${i}/6)…"
    sleep 10
  done
  printf '%s' "$name"
  return 0
}

# Generate the config set on the environment and bring it back as a zip.
# It has to be generated from the SearchStax server: the searchstax module's
# hook_search_api_solr_config_files_alter() only fires for a SearchStax-backed
# server, and it is what adds the SearchStudio handlers to the files.
_solrconfig_generate() {
  local server_id="$1" slug="$2"
  local local_dir="${SRSX_SOLRCONFIG_ROOT}/${slug}"
  rm -rf "$local_dir"
  mkdir -p "$local_dir"

  local remote_dir="/tmp/srsx-solrcfg-${$}-${RANDOM}"
  if ! drush_php_soft export-solr-config.php \
      "SRSX_SERVER_ID=${server_id}" "SRSX_OUT_DIR=${remote_dir}"; then
    warn "Could not generate the config set${DRUSH_URI:+ for ${DRUSH_URI}}."
    warn "  Fall back to the 'Get config.zip' button on the server's admin page."
    return 0
  fi

  if ! acli ssh "${ACQUIA_APP}.${EFFECTIVE_ENV}" -- "cd '${remote_dir}' && tar -cf - ." \
      | tar -xf - -C "$local_dir"; then
    warn "Could not copy the generated config set back from the environment."
    return 0
  fi
  acli ssh "${ACQUIA_APP}.${EFFECTIVE_ENV}" -- "rm -rf '${remote_dir}'" >/dev/null 2>&1 || true

  local archive="${SRSX_SOLRCONFIG_ROOT}/${slug}.zip"
  rm -f "$archive"
  if command -v zip >/dev/null 2>&1; then
    ( cd "$local_dir" && zip -qr "$archive" . ) && ok "Config set archive: ${archive}"
  else
    warn "'zip' is not installed, so no archive was created."
    info "  Zip the CONTENTS of ${local_dir} (not the directory itself) for SearchStax."
  fi
  return 0
}

