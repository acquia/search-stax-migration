#!/usr/bin/env bash
# srsx-migrate — Acquia Search → SearchStax migration toolkit.
#
# Drives the official Acquia migration runbook end-to-end:
#   https://docs.acquia.com/acquia-cloud-platform/migrating-acquia-search-powered-searchstax
#
# Single entry point. All phase logic lives below as `phase_<name>` functions.
# Run `./srsx-migrate --help` for usage.
#
# Copyright 2026 Mohammad Zomorodian, Acquia Inc. (Apache-2.0)

# Bootstrap: associative arrays require bash 4+. macOS ships 3.2; re-exec
# under a newer bash if available, otherwise fail with actionable guidance.
if [ -z "${BASH_VERSINFO+x}" ] || [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
  for cand in /opt/homebrew/bin/bash /usr/local/bin/bash /usr/bin/bash /bin/bash5; do
    # shellcheck disable=SC2016 # single quotes are intentional; expansion runs in $cand.
    if [ -x "$cand" ] && "$cand" -c '[ "${BASH_VERSINFO[0]}" -ge 4 ]' 2>/dev/null; then
      exec "$cand" "$0" "$@"
    fi
  done
  echo "ERROR: srsx-migrate requires bash 4+ (current: ${BASH_VERSION:-unknown})." >&2
  echo "       On macOS:  brew install bash" >&2
  echo "       Then re-run: $0 $*" >&2
  exit 1
fi

set -euo pipefail
shopt -s nullglob

# =============================================================================
# CONSTANTS
# =============================================================================

readonly SCRIPT_NAME="srsx-migrate"
readonly SCRIPT_VERSION="1.0.0-dev"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
# REPO_ROOT is the Drupal/composer project root we operate against (where
# composer.json lives and where Drupal config sync is checked in). Prefer the
# enclosing git toplevel; if we're not in a repo (e.g. fresh demo run), fall
# back to SCRIPT_DIR. May be overridden by enable_demo_mode().
if REPO_ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null)"; then
  :
else
  REPO_ROOT="$SCRIPT_DIR"
fi
readonly DOCS_BASE="https://docs.acquia.com/acquia-cloud-platform"
readonly MIGRATION_DOC="${DOCS_BASE}/migrating-acquia-search-powered-searchstax"

# Per-phase doc URLs (also surfaced via `./srsx-migrate explain <phase>`).
declare -A PHASE_DOC=(
  [preflight]="${DOCS_BASE}/preparing-migration-acquia-search-powered-searchstax"
  [install]="${DOCS_BASE}/installing-searchstax-module"
  [backup]="${DOCS_BASE}/preparing-migration-acquia-search-powered-searchstax"
  [provision]="${DOCS_BASE}/migrating-acquia-search-powered-searchstax#provisioning-searchstax-apps"
  [configure]="${DOCS_BASE}/enabling-searchstax-module-and-routing-searches-through-it"
  [server]="${DOCS_BASE}/migrating-server-drupal-acquia-search-powered-searchstax"
  [index]="${DOCS_BASE}/migrating-index-drupal-acquia-search-powered-searchstax"
  [views]="${DOCS_BASE}/migrating-views-drupal-acquia-search-powered-searchstax"
  [route]="${DOCS_BASE}/enabling-searchstax-module-and-routing-searches-through-it"
  [validate]="${DOCS_BASE}/validating-search-page"
  [handoff]="${DOCS_BASE}/committing-and-deploying-changes"
  [cleanup]="${DOCS_BASE}/removing-legacy-search-module-and-configuration"
)

declare -A PHASE_DESC=(
  [preflight]="Run drush status, sapi-s, sapi-i, pm:list against the target Acquia env to verify versions and inventory the current Solr setup."
  [backup]="Prompt you to trigger an on-demand Acquia DB backup manually (via the Cloud UI) as a restore point before mutating the environment."
  [install]="composer require search_api/search_api_solr/searchstax/key locally, push the branch, wait for Acquia to deploy, then drush updb + cr + en the modules."
  [provision]="Create the SearchStax Site Search app(s) the migration will point at, via the SearchStax REST API. Auto-skipped if SEARCHSTAX_APP_ENDPOINT is already set or in --demo mode."
  [configure]="Prompt for SearchStax credentials; store via Key module or plain config."
  [server]="Create the SearchStax-backed search_api server config."
  [solrconfig]="Configure the SearchStax app so its collection is set up for Drupal, and refuse to continue until it is."
  [index]="Clone each legacy index into a SearchStax-backed copy and reindex."
  [views]="Switch every Search-API view to its new SearchStax-backed index."
  [route]="Enable 'Re-route searches through SearchStudio' + write analytics URL/key."
  [validate]="Assert server URL, item counts, and view bindings on the target env."
  [handoff]="drush cex on target, pull config to local repo, git add. Does NOT commit or push."
  [cleanup]="Uninstall migration submodule, remove legacy server/index/views/modules."
)

# Ordered list of phases for `all` and `status`. Backup runs BEFORE install
# so the customer has a fresh restore point before any composer/drush change.
readonly -a PHASE_ORDER=(
  preflight backup install provision configure server solrconfig index views route validate handoff cleanup
)

# Environment names treated as production. Mutating phases run against
# dev/stage; once you're happy with the result there, you deploy to these
# environments through your normal Acquia workflow.
readonly -a PROD_ENV_NAMES=(prod production live www main master)

# SearchStax caps a single Site Search app at this many Drupal sites. The
# minimum number of apps a multisite needs is therefore ceil(N / 9).
readonly MAX_SITES_PER_APP=9

# =============================================================================
# GLOBAL FLAGS / STATE
# =============================================================================

DRY_RUN=0
DEMO=0
USE_COLOR=1
ASSUME_YES=0
FORCE=0                    # --force re-runs done phases; with 'all' it resets progress first.
RUN_ONLY=0                 # --only stops after the named phase instead of continuing.
SRSX_CURRENT_PHASE=""      # Name of the phase currently running (set by header()).
SRSX_SOLRCONFIG_ROOT=""    # Where 'solrconfig' writes the exported config sets.
SRSX_VERIFY_TOKEN=""       # Token in play for the configure-time SearchStax checks.
PHASE_START_TIME=0         # Unix timestamp when current phase started (set by header()).
declare -a SITES_ARR=()    # Per-site --uri values for multisite mode.
LOG_FILE=""

# Outputs of lib/searchstax_api.sh helpers (assigned by ssx_create_one_app /
# ssx_get_app_detail). Pre-declared here so shellcheck doesn't think
# phase_provision references unset variables (the module is sourced below).
ssx_last_app_id=""
ssx_last_endpoint=""
ssx_last_read_token=""
ssx_last_write_token=""
ssx_last_analytics_url=""

# Acquia app + target env. Loaded from migration.env, captured by ensure_init() if blank.
# EFFECTIVE_ENV is the env used for THIS invocation; defaults to ACQUIA_TARGET_ENV but
# can be overridden by `--env <name>` on the validate subcommand only.
ACQUIA_APP=""
ACQUIA_TARGET_ENV=""
EFFECTIVE_ENV=""
ALLOW_PROD_ENV=0           # Set true only by `validate --env <prodlike>` (read-only).

# Dirs (created at runtime, gitignored). All derived from SRSX_HOME so that
# `--demo` can rebase them under a throwaway tmpdir without touching the
# toolkit's own files (migration.env, state/, logs/, artifacts/). Tests may
# also export SRSX_HOME to point at a sandbox dir.
SRSX_HOME="${SRSX_HOME:-${SCRIPT_DIR}}"
ARTIFACTS_DIR="${SRSX_HOME}/artifacts"
LOG_DIR="${SRSX_HOME}/logs"
STATE_DIR="${SRSX_HOME}/state"   # Tracks last completed phase, etc.
ENV_FILE="${SRSX_HOME}/migration.env"

# =============================================================================
# COLOR + OUTPUT HELPERS
# =============================================================================

# Defaults so output helpers work even before init_colors() runs (set -u safe).
C_HEAD=""; C_OK=""; C_WARN=""; C_ERR=""
C_PROMPT=""; C_DIM=""; C_BOLD=""; C_RST=""

init_colors() {
  if [[ "$USE_COLOR" == "1" ]] \
     && [[ -t 1 ]] \
     && [[ "${NO_COLOR:-}" == "" ]] \
     && [[ "${TERM:-dumb}" != "dumb" ]]; then
    C_HEAD=$'\033[1;36m'   # bold cyan
    C_OK=$'\033[1;32m'     # bold green
    C_WARN=$'\033[1;33m'   # bold yellow
    C_ERR=$'\033[1;31m'    # bold red
    C_PROMPT=$'\033[1;35m' # bold magenta
    C_DIM=$'\033[2m'       # dim
    C_BOLD=$'\033[1m'
    C_RST=$'\033[0m'
  else
    C_HEAD=""; C_OK=""; C_WARN=""; C_ERR=""
    C_PROMPT=""; C_DIM=""; C_BOLD=""; C_RST=""
  fi
}

# Phase header — call as `header "preflight" "Verify environment"`.
# Stores the start time for later duration calculation.
header() {
  local phase="$1" subtitle="${2:-}"
  PHASE_START_TIME="$(date +%s)"
  SRSX_CURRENT_PHASE="$phase"
  printf '\n%s' "$C_HEAD"
  printf '═%.0s' {1..71}
  printf '%s\n' "$C_RST"
  if [[ "$DEMO" == "1" ]]; then
    printf '%s[DEMO MODE — no real changes]%s\n' "$C_WARN" "$C_RST"
  fi
  if [[ "$DRY_RUN" == "1" ]]; then
    printf '%s[DRY RUN — commands not executed]%s\n' "$C_WARN" "$C_RST"
  fi
  printf '%s▶ Phase: %s%s%s' "$C_HEAD" "$C_BOLD" "$phase" "$C_RST"
  [[ -n "$subtitle" ]] && printf ' — %s' "$subtitle"
  printf '\n'
  if [[ -n "${ACQUIA_APP:-}" && -n "${EFFECTIVE_ENV:-}" ]]; then
    printf '  %sTarget:  %s%s.%s%s\n' \
      "$C_DIM" "$C_BOLD" "${ACQUIA_APP}" "${EFFECTIVE_ENV}" "$C_RST"
  fi
  if [[ -n "${PHASE_DOC[$phase]:-}" ]]; then
    printf '  %sDoc:     %s%s\n' "$C_DIM" "${PHASE_DOC[$phase]}" "$C_RST"
  fi
  printf '%s' "$C_HEAD"
  printf '═%.0s' {1..71}
  printf '%s\n' "$C_RST"
}

ok()   { printf '%s[OK]%s %s\n' "$C_OK" "$C_RST" "$*"; }
warn() { printf '%s[WARN]%s %s\n' "$C_WARN" "$C_RST" "$*" >&2; }
err()  { printf '%s[ERROR]%s %s\n' "$C_ERR" "$C_RST" "$*" >&2; exit 1; }
info() { printf '%s\n' "$*"; }
dim()  { printf '%s%s%s\n' "$C_DIM" "$*" "$C_RST"; }

# Emit a `+ command` audit line in dim grey before executing.
audit() {
  printf '%s+ %s%s\n' "$C_DIM" "$*" "$C_RST"
}

# =============================================================================
# COMMAND EXECUTION (DRY-RUN AWARE)
# =============================================================================

# run <args...> — print + execute; under --dry-run, only print.
# SRSX_AUDIT_OVERRIDE replaces the echoed command for calls whose real
# argv is too large to be readable (e.g. an inlined php:eval body).
run() {
  audit "${SRSX_AUDIT_OVERRIDE:-$*}"
  if [[ "$DRY_RUN" == "1" ]]; then
    return 0
  fi
  "$@"
}

# run_capture <varname> <args...> — print + execute, capture stdout into $varname.
# Under --dry-run, sets $varname to empty string.
run_capture() {
  local var="$1"; shift
  audit "$*"
  if [[ "$DRY_RUN" == "1" ]]; then
    printf -v "$var" '%s' ""
    return 0
  fi
  local _out
  _out="$("$@")" || return $?
  printf -v "$var" '%s' "$_out"
}

# Drush wrapper. ALWAYS invoked via `acli remote:drush <app>.<env> --` so that
# every mutation lands on the customer's Acquia dev/stage environment, never
# on their laptop's local Drupal. Per-site multisite iteration uses --uri=...
DRUSH_URI=""
drush() {
  [[ -n "${ACQUIA_APP:-}" ]] || err "ACQUIA_APP not set. Run './srsx-migrate init' or set it in migration.env."
  [[ -n "${EFFECTIVE_ENV:-}" ]] || err "EFFECTIVE_ENV not set. (Internal bug — ensure_init not called?)"
  local -a cmd=(acli remote:drush "${ACQUIA_APP}.${EFFECTIVE_ENV}" --)
  if [[ -n "$DRUSH_URI" ]]; then
    cmd+=(--uri="$DRUSH_URI")
  fi
  cmd+=("$@")
  run "${cmd[@]}"
}

# Same as drush(), but captures output into $1.
drush_capture() {
  local var="$1"; shift
  [[ -n "${ACQUIA_APP:-}" ]] || err "ACQUIA_APP not set. Run './srsx-migrate init' first."
  [[ -n "${EFFECTIVE_ENV:-}" ]] || err "EFFECTIVE_ENV not set."
  local -a cmd=(acli remote:drush "${ACQUIA_APP}.${EFFECTIVE_ENV}" --)
  [[ -n "$DRUSH_URI" ]] && cmd+=(--uri="$DRUSH_URI")
  cmd+=("$@")
  run_capture "$var" "${cmd[@]}"
}

# drush_php <script.php> [KEY=VALUE ...] — run one of lib/php-eval/*.php on the
# REMOTE environment.
#
# The toolkit lives in a gitignored tools/ directory that is never deployed, so
# a local path means nothing remotely, and SRSX_* variables set locally do not
# survive the SSH hop.
#
# Passing the code as an argument does not work either. acli builds the remote
# command by joining argv into a `bash -c` string and drops any quoting on the
# way, so the remote shell always parses the payload:
#   cd …/docroot; drush --uri=… php:eval /*…*/eval(base64_decode("…"));
#   /bin/bash: -c: line 0: syntax error near unexpected token `('
# No amount of quoting survives that, because the quotes themselves are eaten.
#
# So the script never travels through argv: it is piped over stdin, which acli
# does not touch, and only shell-safe paths appear on the command line. The body
# is wrapped in a closure so its top-level `return` becomes the status, and it
# must not exit(), which would kill drush mid-command.
drush_php() {
  local script="$1"; shift
  local file="${SCRIPT_DIR}/lib/php-eval/${script}"
  [[ -f "$file" ]] || err "php-eval script missing: ${file}"

  local marker="SRSXOK${$}"
  local body='<?php'$'\n'
  local kv key val b64
  for kv in "$@"; do
    key="${kv%%=*}"; val="${kv#*=}"
    b64="$(printf '%s' "$val" | base64 | tr -d '\n')"
    body+="putenv('${key}=' . base64_decode('${b64}'));"$'\n'
  done
  body+="echo '${marker}' . PHP_EOL;"$'\n'
  # shellcheck disable=SC2016 # $srsxrc is PHP, not shell — it must stay literal.
  body+='$srsxrc = (function () {'$'\n'
  body+="$(tail -n +2 "$file")"$'\n'
  body+='})();'$'\n'
  body+="echo '${marker}RC' . intval(\$srsxrc) . PHP_EOL;"$'\n'

  local remote_dir="/tmp/srsx-${$}"
  local remote_file="${remote_dir}/${script}"
  local label="acli remote:drush ${ACQUIA_APP}.${EFFECTIVE_ENV} --${DRUSH_URI:+ --uri=${DRUSH_URI}} php:script ${script}"
  info "Running ${script} on ${ACQUIA_APP}.${EFFECTIVE_ENV}${DRUSH_URI:+ (${DRUSH_URI})}"

  if [[ "$DRY_RUN" == "1" ]]; then
    audit "$label"
    return 0
  fi
  if [[ "$DEMO" == "1" ]]; then
    SRSX_AUDIT_OVERRIDE="$label" drush php:script "$remote_file" "$@"
    return 0
  fi

  # Ship the script over stdin. Every token on the command line here is a plain
  # path, so there is nothing for the remote shell to misparse.
  audit "acli ssh ${ACQUIA_APP}.${EFFECTIVE_ENV} -- cat > ${remote_file}"
  printf '%s' "$body" \
    | acli ssh "${ACQUIA_APP}.${EFFECTIVE_ENV}" -- "mkdir -p ${remote_dir} && cat > ${remote_file}" \
    || err "Could not copy ${script} to ${ACQUIA_APP}.${EFFECTIVE_ENV}.
       'acli ssh' must be able to reach the environment for this phase to run."

  local out
  out="$(SRSX_AUDIT_OVERRIDE="$label" drush php:script --script-path="$remote_dir" "$script" 2>&1)" || true
  if [[ "$out" != *"$marker"* ]]; then
    # Older drush without --script-path: name the file outright.
    out="$(SRSX_AUDIT_OVERRIDE="$label" drush php:script "$remote_file" 2>&1)" || true
  fi
  acli ssh "${ACQUIA_APP}.${EFFECTIVE_ENV}" -- "rm -rf ${remote_dir}" >/dev/null 2>&1 || true

  if [[ "$out" != *"$marker"* ]]; then
    printf '%s\n' "$out"
    err "Could not execute ${script} on ${ACQUIA_APP}.${EFFECTIVE_ENV}. Output above."
  fi

  local phprc
  phprc="$(sed -n "s/.*${marker}RC\([0-9][0-9]*\).*/\1/p" <<<"$out" | tail -1)"
  printf '%s\n' "$out" | grep -vF "$marker" || true

  if [[ -z "$phprc" ]]; then
    if [[ "$out" == *"container is not initialized"* ]]; then
      err "Drupal did not bootstrap on ${ACQUIA_APP}.${EFFECTIVE_ENV}${DRUSH_URI:+ for --uri=${DRUSH_URI}}.
       drush ran, but no site was booted, so ${script} could not touch config.
       This is what happens on a multisite when no --uri is passed.
       If ${ACQUIA_APP} is a multisite (Site Factory included), declare the
       sites once and re-run:
         ./srsx-migrate init        # answer 'y' to the multisite question
         ./srsx-migrate ${SRSX_CURRENT_PHASE:-server} --force
       Current SITES: ${SITES:-(none — treated as single-site)}"
    fi
    err "${script} stopped part-way on ${ACQUIA_APP}.${EFFECTIVE_ENV} (PHP fatal). Output above."
  fi
  (( phprc == 0 )) || err "${script} reported failure (code ${phprc}) on ${ACQUIA_APP}.${EFFECTIVE_ENV}. Output above."
  return 0
}

# drush_php_soft <script.php> [KEY=VAL ...] — same, but a failure returns
# non-zero instead of ending the run. drush_php reports problems through err(),
# which exits; the subshell keeps that exit local so a per-site phase can record
# the failure and move on to the next site.
drush_php_soft() {
  ( drush_php "$@" )
}

# drush_cr — rebuild caches without letting a broken container abort the run.
#
# A contrib module with a bad service definition makes container compilation
# fail, so every subsequent `drush cr` fails too. That is worth reporting
# loudly, but it must not strand the migration half-way through: the config
# changes around it are already saved and the remaining phases still apply.
SRSX_CR_FAILED=0
SRSX_CR_PROBED=0
drush_cr() {
  local out="" rc=0
  local label="acli remote:drush ${ACQUIA_APP}.${EFFECTIVE_ENV} --${DRUSH_URI:+ --uri=${DRUSH_URI}} cr"
  out="$(SRSX_AUDIT_OVERRIDE="$label" drush cr 2>&1)" || rc=$?
  [[ -n "$out" ]] && printf '%s\n' "$out"
  (( rc == 0 )) && return 0

  SRSX_CR_FAILED=1
  warn "Cache rebuild failed${DRUSH_URI:+ on ${DRUSH_URI}} — continuing with the migration."
  if [[ "$out" == *"must implement interface"* && "$out" == *"EventSubscriberInterface"* ]]; then
    local svc class
    svc="$(sed -n 's/.*Service "\([^"]*\)" must implement.*/\1/p' <<<"$out" | head -1)"
    warn "  Drupal decides this by reflecting on the class it loaded, so the class
       actually in memory does not implement EventSubscriberInterface. In the
       searchstax module every recent release does implement it, so this is
       normally stale or mismatched code on the environment rather than a bug
       in the module: an old opcache copy, a second copy of the module, or code
       that has not been redeployed. Until the container compiles, the site
       keeps serving its previously built container, so your config changes
       will not take effect on the front end."
    # Ask the environment which file it actually loaded — that separates a stale
    # opcache from genuinely old deployed code.
    if [[ "$DEMO" == "0" && "$DRY_RUN" == "0" ]] && (( SRSX_CR_PROBED == 0 )); then
      SRSX_CR_PROBED=1
      class="$(_ssx_service_class "$svc")"
      info "Inspecting ${class} on ${ACQUIA_APP}.${EFFECTIVE_ENV}…"
      drush_php inspect-service-class.php "SRSX_CLASS=${class}" || \
        warn "  Could not inspect ${class}; check the module code on the environment by hand."
    fi
  fi
  return 0
}

# Best-effort service id → class name for the searchstax services we know about.
_ssx_service_class() {
  case "$1" in
    searchstax.flood_subscriber)               printf 'Drupal\\searchstax\\EventSubscriber\\FloodSubscriber' ;;
    searchstax.solr_error_detection_subscriber) printf 'Drupal\\searchstax\\EventSubscriber\\SolrErrorDetectionSubscriber' ;;
    searchstax.solr_event_subscriber)          printf 'Drupal\\searchstax\\EventSubscriber\\SearchSubscriber' ;;
    searchstax.solr_request_event_subscriber)  printf 'Drupal\\searchstax\\EventSubscriber\\SolrRequestBypassSubscriber' ;;
    *)                                         printf '%s' "$1" ;;
  esac
}

# ---------------------------------------------------------------------------
# Search-API drush command wrappers.
#
# Correct drush aliases for search_api:
#   sapi-sl  = search-api:server-list  (list servers, supports --format=json)
#   sapi-s   = search-api:status       (list indexes + counts, supports --format=json)
#   sapi-rt  = search-api:reset-tracker (reset tracker for an index)
#   sapi-i   = search-api:index        (ACTION: trigger indexing, NOT a list cmd)
#   sapi-c   = search-api:clear        (clear an index)
#   sapi-r   = search-api:rebuild-tracker (rebuild tracker)
# ---------------------------------------------------------------------------

# _drush_sapi_servers <varname> — capture server list as JSON
_drush_sapi_servers() {
  drush_capture "$1" search-api:server-list --format=json
}

# _drush_sapi_indexes <varname> — capture index status (with counts) as JSON.
# NOTE: this reports id/name/complete/indexed/total only — it carries NO server
# field. Use _drush_sapi_list when you need to know which server an index is on.
_drush_sapi_indexes() {
  drush_capture "$1" search-api:status --format=json
}

# _drush_sapi_list <varname> — capture the index list as JSON.
#
# --fields is NOT optional. The command's default field set is
# id,name,serverName,typeNames,status,limit: `serverName` is a human label and
# the machine-readable `server` (a server ID) is omitted, so the default JSON
# cannot tell you which server an index is on. Ask for the columns by name.
_drush_sapi_list() {
  drush_capture "$1" search-api:list --format=json --fields=id,name,server,serverName,status
}

# Run a shell command on the target Acquia env via `acli ssh`. Used by Phase
# 'handoff' to pull config files exported on the remote into the local repo.
acli_ssh() {
  [[ -n "${ACQUIA_APP:-}" ]] || err "ACQUIA_APP not set."
  [[ -n "${EFFECTIVE_ENV:-}" ]] || err "EFFECTIVE_ENV not set."
  run acli ssh "${ACQUIA_APP}.${EFFECTIVE_ENV}" -- "$@"
}

# Capturing variant of acli_ssh.
acli_ssh_capture() {
  local var="$1"; shift
  [[ -n "${ACQUIA_APP:-}" ]] || err "ACQUIA_APP not set."
  [[ -n "${EFFECTIVE_ENV:-}" ]] || err "EFFECTIVE_ENV not set."
  run_capture "$var" acli ssh "${ACQUIA_APP}.${EFFECTIVE_ENV}" -- "$@"
}

composer_in_repo() {
  ( cd "$REPO_ROOT" && run command composer "$@" )
}

# composer_in_repo_capture <args...> — like composer_in_repo, but captures the
# combined stdout+stderr into SRSX_COMPOSER_OUTPUT (while still echoing it) and
# returns composer's real exit code WITHOUT tripping `set -e`, so the caller can
# inspect the result and report per-package status. Under --dry-run it is a
# no-op that returns success.
SRSX_COMPOSER_OUTPUT=""
composer_in_repo_capture() {
  audit "composer $*"
  if [[ "$DRY_RUN" == "1" ]]; then
    SRSX_COMPOSER_OUTPUT=""
    return 0
  fi
  local _out _rc=0
  _out="$( cd "$REPO_ROOT" && command composer "$@" 2>&1 )" || _rc=$?
  printf '%s\n' "$_out"
  SRSX_COMPOSER_OUTPUT="$_out"
  return "$_rc"
}

# _report_composer_result <rc> <pkg...> — inspect SRSX_COMPOSER_OUTPUT (the
# output of the preceding `composer require`) and tell the user, per package,
# whether it was newly installed, updated, or already present. Anything that
# cannot be accounted for is counted in SRSX_INSTALL_MISSING and, if the
# require itself failed, aborts with actionable guidance.
SRSX_INSTALL_MISSING=0
_report_composer_result() {
  local rc="$1"; shift
  local out="$SRSX_COMPOSER_OUTPUT"
  SRSX_INSTALL_MISSING=0

  info ""
  info "── Composer install verification ─────────────────────────────────────"

  local pkg esc ver
  for pkg in "$@"; do
    esc="${pkg//./\\.}"
    # Version this run reported for the package, if any (e.g. "1.11.0").
    # `|| true` keeps a no-match grep from tripping set -e/pipefail on assign.
    ver="$( { printf '%s\n' "$out" \
      | grep -oiE "(Installing|Locking|Upgrading|Updating|Downgrading) ${esc} \([^)]+\)" \
      | grep -oE '\([^)]+\)' | tr -d '()' | head -n1; } || true )"

    if printf '%s\n' "$out" | grep -qiE "Installing ${esc} \("; then
      ok "  installed   ${pkg}${ver:+ (${ver})}"
    elif printf '%s\n' "$out" | grep -qiE "(Upgrading|Updating|Downgrading) ${esc} \("; then
      ok "  updated     ${pkg}${ver:+ (${ver})}"
    elif (( rc == 0 )); then
      # require succeeded but composer performed no operation for this package,
      # so it was already present at a satisfying version. Confirm the exact
      # installed version via `composer show` (skipped in demo/dry-run).
      local cur=""
      if [[ "$DEMO" != "1" && "$DRY_RUN" != "1" ]]; then
        cur="$( { cd "$REPO_ROOT" && command composer show "$pkg" 2>/dev/null \
                | awk '/^versions/ {print $NF; exit}'; } || true )"
      fi
      ok "  up-to-date  ${pkg}${cur:+ (${cur})} — already installed, no change"
    else
      warn "  FAILED      ${pkg} — not installed (composer require exited ${rc})"
      SRSX_INSTALL_MISSING=$((SRSX_INSTALL_MISSING+1))
    fi
  done
  info "──────────────────────────────────────────────────────────────────────"

  if (( rc != 0 )) || (( SRSX_INSTALL_MISSING > 0 )); then
    err "composer require failed (exit ${rc}, ${SRSX_INSTALL_MISSING} package(s) missing).
       Review the composer output above, resolve the conflict, then re-run:
         ./srsx-migrate install --force"
  fi
}

# _ensure_tools_gitignore — make sure the toolkit directory is git-ignored in
# the customer's repo. tools/searchstax-migration/ holds runtime state, logs,
# artifacts and migration.env (which may contain secrets); none of it belongs
# in the deployable code, and it can be reinstalled any time via install.sh.
# Idempotent: only writes the file if it is missing.
_ensure_tools_gitignore() {
  local gi="${SRSX_HOME}/.gitignore"
  [[ -e "$gi" ]] && return 0
  cat > "$gi" <<'GITIGNORE_EOF'
# Managed by srsx-migrate — do NOT commit the migration toolkit into your repo.
# This directory holds runtime state, logs, artifacts, and migration.env
# (which may contain secrets). Reinstall any time via install.sh.
*
GITIGNORE_EOF
  info "Wrote ${gi} (keeps the toolkit + migration.env out of your repo)."
}

# git_commit_safe <message> — commit staged changes in REPO_ROOT without dying
# under `set -e` when there is genuinely nothing to commit (idempotent re-runs),
# and surface a clear, actionable error for the two failure modes that
# otherwise stop the script silently mid-commit: a missing git identity and a
# rejecting pre-commit hook.
git_commit_safe() {
  local msg="$1"
  if [[ "$DRY_RUN" == "1" ]]; then
    audit "git commit -m \"$msg\""
    return 0
  fi
  # Nothing staged → nothing to commit. Not an error (e.g. resuming a run whose
  # commit already landed).
  if ( cd "$REPO_ROOT" && command git diff --cached --quiet 2>/dev/null ); then
    info "Nothing staged to commit — skipping commit (already committed?)."
    return 0
  fi
  # A missing user.name/user.email makes `git commit` fail with a confusing
  # message and, under set -e, kills the whole run.
  local gname gemail
  gname="$( cd "$REPO_ROOT" && command git config user.name  2>/dev/null || true )"
  gemail="$( cd "$REPO_ROOT" && command git config user.email 2>/dev/null || true )"
  if [[ -z "$gname" || -z "$gemail" ]]; then
    err "git identity is not configured in ${REPO_ROOT}, so the commit was skipped.
       Set it, then re-run './srsx-migrate install --force':
         git -C \"${REPO_ROOT}\" config user.name  \"Your Name\"
         git -C \"${REPO_ROOT}\" config user.email \"you@example.com\""
  fi
  local rc=0
  ( cd "$REPO_ROOT" && run git commit -m "$msg" ) || rc=$?
  if (( rc != 0 )); then
    err "git commit failed (exit ${rc}) in ${REPO_ROOT}.
       A pre-commit hook or repository policy likely rejected the commit.
       Review the output above, resolve it, then re-run:
         ./srsx-migrate install --force"
  fi
}

# _stage_install_changes — stage EVERYTHING Composer produced so the pushed
# branch is a complete, deployable tree that never depends on an external build
# step. composer.json/lock plus the built code (vendor/ and contrib
# modules/themes/profiles/libraries/core) are staged with `git add -f`, so even
# repos that git-ignore those dirs still commit and push the actual code. This
# guarantees the deploy contains everything.
_stage_install_changes() {
  ( cd "$REPO_ROOT" && run git add composer.json composer.lock )

  local -a artifact_dirs=(
    vendor
    docroot/core docroot/modules/contrib docroot/themes/contrib docroot/profiles/contrib docroot/libraries
    web/core     web/modules/contrib     web/themes/contrib     web/profiles/contrib     web/libraries
  )
  local d staged=0
  for d in "${artifact_dirs[@]}"; do
    [[ -d "${REPO_ROOT}/${d}" ]] || continue
    # -f forces staging even when the dir is git-ignored (build-artifact repos),
    # so the full Composer output is committed. Tolerate an empty/failed add so
    # a single dir never aborts the phase.
    if ( cd "$REPO_ROOT" && run git add -f "$d" ); then
      staged=1
    else
      warn "Could not stage ${d} — continuing."
    fi
  done

  if (( staged )); then
    info "Staged composer.json/lock + all Composer-built code (vendor, contrib,"
    info "libraries) with 'git add -f' so the full tree is committed and pushed."
  else
    info "Staged composer.json + composer.lock (no vendor/contrib dirs present yet)."
  fi
}

# =============================================================================
# INTERACTIVE PROMPTS
# =============================================================================

# confirm <message> — Enter to continue, Ctrl-C to abort.
# Skipped under --yes or non-TTY (e.g. CI).
confirm() {
  local msg="$1"
  if [[ "$ASSUME_YES" == "1" ]] || [[ ! -t 0 ]]; then
    info "${C_PROMPT}? ${msg}${C_RST} [auto-yes]"
    return 0
  fi
  printf '%s? %s%s — Press Enter to continue, Ctrl-C to abort: ' \
    "$C_PROMPT" "$msg" "$C_RST"
  read -r _
}

# ask <prompt> <varname> [<default>] — capture freeform input.
ask() {
  local prompt="$1" var="$2" default="${3:-}"
  if (( ${#DEMO_ANSWERS_ARR[@]} > 0 )); then
    local ans="${DEMO_ANSWERS_ARR[0]}"
    DEMO_ANSWERS_ARR=("${DEMO_ANSWERS_ARR[@]:1}")
    info "${C_PROMPT}? ${prompt}${C_RST} [scripted: ${ans}]"
    printf -v "$var" '%s' "$ans"
    return 0
  fi
  local suffix=""
  [[ -n "$default" ]] && suffix=" [default: ${default}]"
  printf '%s? %s%s%s: ' "$C_PROMPT" "$prompt" "$suffix" "$C_RST"
  local input
  read -r input || input=""
  [[ -z "$input" && -n "$default" ]] && input="$default"
  printf -v "$var" '%s' "$input"
}

# ask_saved <prompt> <varname> [<empty-default>] — ask only when the variable
# has no value, so a saved answer is not re-typed on every run. Under --force,
# ask again with the saved value as the default: that is the only way to correct
# an answer that was persisted wrong, since every later phase reads it back and
# skips its own prompt.
ask_saved() {
  local prompt="$1" var="$2" empty_default="${3:-}"
  local current="${!var:-}"
  if [[ -n "$current" && "$FORCE" != "1" ]]; then
    return 0
  fi
  if [[ -n "$current" ]]; then
    ask "$prompt" "$var" "$current"
  else
    ask "$prompt" "$var" "$empty_default"
  fi
  return 0
}

# ask_secret <prompt> <varname> — input echo disabled.
ask_secret() {
  local prompt="$1" var="$2"
  if (( ${#DEMO_ANSWERS_ARR[@]} > 0 )); then
    local ans="${DEMO_ANSWERS_ARR[0]}"
    DEMO_ANSWERS_ARR=("${DEMO_ANSWERS_ARR[@]:1}")
    info "${C_PROMPT}? ${prompt}${C_RST} [scripted: ********]"
    printf -v "$var" '%s' "$ans"
    return 0
  fi
  printf '%s? %s%s (input hidden): ' "$C_PROMPT" "$prompt" "$C_RST"
  local input
  read -r -s input || input=""
  printf '\n'
  printf -v "$var" '%s' "$input"
}

# ask_choice <prompt> <varname> <opt1> <opt2> ...
ask_choice() {
  local prompt="$1" var="$2"; shift 2
  local -a opts=("$@")
  printf '%s? %s%s\n' "$C_PROMPT" "$prompt" "$C_RST"
  local i=1
  for o in "${opts[@]}"; do
    printf '    [%d] %s\n' "$i" "$o"
    i=$((i + 1))
  done
  local selected_index
  if (( ${#DEMO_ANSWERS_ARR[@]} > 0 )); then
    selected_index="${DEMO_ANSWERS_ARR[0]}"
    DEMO_ANSWERS_ARR=("${DEMO_ANSWERS_ARR[@]:1}")
    info "  [scripted choice: ${selected_index}]"
  else
    printf '  Choice [1]: '
    read -r selected_index || selected_index=1
    [[ -z "$selected_index" ]] && selected_index=1
  fi
  if [[ ! "$selected_index" =~ ^[0-9]+$ ]] || (( selected_index < 1 || selected_index > ${#opts[@]} )); then
    err "Invalid choice: $selected_index"
  fi
  printf -v "$var" '%s' "${opts[$((selected_index-1))]}"
}

# Pause between phases when in --demo mode so the user can read the output
# and Press Enter to step to the next phase. Skipped automatically when stdin
# is not a TTY (e.g. when running under CI or piped input).
demo_pause() {
  [[ "$DEMO" == "1" ]] || return 0
  [[ ! -t 0 ]] && return 0
  printf '\n%s[demo: press Enter for next phase…]%s' "$C_DIM" "$C_RST"
  read -r _ || true
  printf '\n'
}

# Realistic latency for demo so it doesn't feel like a teleprompter dump.
demo_sleep() {
  [[ "$DEMO" == "1" ]] || return 0
  [[ ! -t 0 ]] && return 0
  local secs="${1:-0.6}"
  sleep "$secs" 2>/dev/null || true
}

