print_status() {
  local last; last="$(state_get last-phase)"
  if [[ -z "$last" ]]; then
    info "No phase has run yet. Start with: ./srsx-migrate"
    return 0
  fi
  info "Last completed phase: ${C_BOLD}${last}${C_RST}"
  # Suggest next phase.
  local i=0
  for p in "${PHASE_ORDER[@]}"; do
    if [[ "$p" == "$last" ]]; then
      local next="${PHASE_ORDER[$((i+1))]:-(done)}"
      info "Next:                 ${C_BOLD}${next}${C_RST}"
      info "Run:                  ./srsx-migrate ${next}"
      return 0
    fi
    i=$((i + 1))
  done
}

print_explain() {
  local phase="${1:-}"
  [[ -n "$phase" ]] || err "Usage: ./srsx-migrate explain <phase>"
  [[ -n "${PHASE_DESC[$phase]:-}" ]] || err "Unknown phase: ${phase}
       Valid phases: ${PHASE_ORDER[*]}"
  printf '%s%s%s\n' "$C_BOLD" "$phase" "$C_RST"
  printf '  %s\n' "${PHASE_DESC[$phase]}"
  printf '  Acquia doc: %s\n' "${PHASE_DOC[$phase]:-(none)}"
}

run_all() {
  _warn_active_overrides
  local started=0
  local from="${RUN_FROM:-${PHASE_ORDER[0]}}"
  for p in "${PHASE_ORDER[@]}"; do
    if [[ "$started" == "0" ]]; then
      if [[ "$p" == "$from" ]]; then
        started=1
      else
        continue
      fi
    fi
    case "$p" in
      cleanup)
        # Cleanup is dangerous; always pause before it.
        confirm "About to run final cleanup (uninstall acquia_search etc.). Skip with Ctrl-C if not ready."
        "phase_$p"
        ;;
      *)
        "phase_$p"
        demo_pause
        ;;
    esac
  done
  srsx_cr_reminder
}

# A failed container rebuild is easy to scroll past, so restate it at the end.
srsx_cr_reminder() {
  (( SRSX_CR_FAILED )) || return 0
  printf '\n'
  warn "One or more cache rebuilds failed during this run."
  warn "  Drupal is still serving its previously compiled service container, so the
       migrated search config will NOT be live until 'drush cr' succeeds, and a
       deploy to another environment will fail there too — a container that
       cannot compile means the site cannot boot. Resolve it before deploying.
       Retry with:  acli remote:drush ${ACQUIA_APP}.${EFFECTIVE_ENV} -- cr"
}

# A leftover SRSX_* export from an earlier one-off silently changes what a full
# run does — SRSX_ROLLBACK_VIEWS in particular turns the views phase into a
# rollback and switches nothing.
_warn_active_overrides() {
  local v had=0
  for v in SRSX_COPY_INDEXES SRSX_SWITCH_VIEWS SRSX_ROLLBACK_VIEWS SRSX_NEW_SERVER_ID; do
    [[ -n "${!v:-}" ]] || continue
    (( had == 0 )) && warn "Overrides are active in this shell:"
    had=1
    warn "  ${v}=${!v}"
  done
  (( had == 0 )) && return 0
  if [[ -n "${SRSX_ROLLBACK_VIEWS:-}" ]]; then
    warn "  SRSX_ROLLBACK_VIEWS makes the views phase roll back instead of switching."
  fi
  confirm "Continue with those overrides in effect?"
}

dispatch() {
  case "${1:-interactive}" in
    interactive)
      ensure_init
      if [[ "$FORCE" == "1" ]]; then
        clear_progress_state
        RUN_FROM="${PHASE_ORDER[0]}"
      else
        resume_or_select
      fi
      run_all
      ;;
    all)
      ensure_init
      if [[ "$FORCE" == "1" ]]; then
        clear_progress_state
      fi
      RUN_FROM="${PHASE_ORDER[0]}"
      run_all
      ;;
    init)
      # Full reset of the setup wizard: clear the marker AND every saved
      # answer (app, env, multisite) so all questions are asked again.
      rm -f "${STATE_DIR}/init.done"
      ACQUIA_APP=""; ACQUIA_TARGET_ENV=""
      SITES=""; SITES_ARR=()
      ensure_init
      ;;
    preflight|install|backup|provision|configure|server|solrconfig|index|views|route|handoff|cleanup)
      ensure_init
      if [[ "$RUN_ONLY" == "1" ]]; then
        "phase_$1"
      else
        # Naming a phase means "pick up here" — continue through the remaining
        # phases. Use --only to run just the one.
        RUN_FROM="$1"
        run_all
      fi
      ;;
    validate)
      # Read-only and frequently pointed at another env with --env, so it never
      # rolls on into the mutating phases that follow it.
      ensure_init
      "phase_validate"
      ;;
    doctor)              ensure_init; run_doctor ;;
    status)              print_status ;;
    explain)             shift; print_explain "${1:-}" ;;
    --help|-h|help)      print_help ;;
    --version|-V)        printf '%s %s\n' "$SCRIPT_NAME" "$SCRIPT_VERSION" ;;
    *)
      err "Unknown command: $1
       Run './srsx-migrate --help' for usage."
      ;;
  esac
}

# =============================================================================
# MAIN
# =============================================================================

main() {
  # Parse global flags first (in any order before the subcommand).
  local -a positional=()
  local env_override=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run)   DRY_RUN=1; shift ;;
      --demo)      enable_demo_mode; shift ;;
      --no-color)  USE_COLOR=0; shift ;;
      --yes|-y)    ASSUME_YES=1; shift ;;
      --force)     FORCE=1; shift ;;
      --only)      RUN_ONLY=1; shift ;;
      --env)
        [[ $# -ge 2 ]] || err "--env requires a value (e.g. --env prod)"
        env_override="$2"; shift 2 ;;
      --env=*)     env_override="${1#--env=}"; shift ;;
      --)          shift; positional+=("$@"); break ;;
      *)           positional+=("$1"); shift ;;
    esac
  done

  init_colors
  load_env
  load_demo_answers

  # Set up logging (mirror everything to a per-run log).
  mkdir -p "$LOG_DIR"
  LOG_FILE="${LOG_DIR}/$(date +%Y%m%d-%H%M%S)-srsx.log"
  exec > >(tee -a "$LOG_FILE") 2>&1
  # Make sure the tee subshell flushes whatever we printed before the script
  # exits — otherwise quick exits (e.g. "already complete") show nothing.
  trap 'exec >&- 2>&-; wait 2>/dev/null || true' EXIT

  # --env <name> is only honored by the read-only `validate` subcommand.
  # Anywhere else it is silently ignored — we never let an arbitrary flag
  # change the target of a mutating phase.
  if [[ -n "$env_override" ]]; then
    if [[ "${positional[0]:-}" == "validate" ]]; then
      EFFECTIVE_ENV="$env_override"
      if is_prod_env "$env_override"; then
        ALLOW_PROD_ENV=1
        warn "Running validate against production env '${env_override}' (read-only)."
      fi
    else
      warn "--env is only honored by 'validate'. Ignored for '${positional[0]:-interactive}'."
    fi
  fi

  dispatch "${positional[@]:-interactive}"
}

main "$@"
