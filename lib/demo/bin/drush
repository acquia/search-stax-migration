#!/usr/bin/env bash
# Demo shim for `drush`. Returns canned fixtures from $SRSX_DEMO_FIXTURES.
# Activated when srsx-migrate runs with --demo (PATH is prepended with this dir).
set -euo pipefail

FIX="${SRSX_DEMO_FIXTURES:-$(cd "$(dirname "$0")/../fixtures" && pwd)}"
# Mutable run state lives outside the repo's fixtures dir.
DSTATE="${SRSX_DEMO_STATE:-$FIX}"
mkdir -p "$DSTATE"

emit() {
  local f="$FIX/$1"
  if [[ -f "$f" ]]; then
    cat "$f"
  else
    printf '{}\n'
  fi
}

# Strip --uri=… and other global drush flags before matching the subcommand.
args=()
for a in "$@"; do
  case "$a" in
    --uri=*|--root=*|--format=*|-y|--yes|--no-interaction) ;;
    --) ;;
    *) args+=("$a") ;;
  esac
done
sub="${args[0]:-}"

case "$sub" in
  status)         emit drush-status.json ;;
  # Correct drush command mapping:
  #   sapi-sl / search-api:server-list → list servers
  #   sapi-s  / search-api:status      → list indexes with counts
  #   sapi-rt / search-api:reset-tracker → reset tracker (action)
  sapi-sl|search-api:server-list)         emit drush-sapi-s.json ;;
  sapi-l|search-api:list)
    # The only command that reports which server an index is on.
    if [[ -f "$DSTATE/.state-after-clone" ]]; then
      emit drush-sapi-list-after-copy.json
    else
      emit drush-sapi-list.json
    fi
    ;;
  searchstax:*)
    # The toolkit deliberately calls the module's services directly instead of
    # its drush commands, which only exist from searchstax 1.12.0.
    echo "  There are no commands defined in the \"searchstax\" namespace." >&2
    exit 1
    ;;
  sapi-s|search-api:status)
    # If a state file says "after-clone", return the post-clone variant.
    if [[ -f "$DSTATE/.state-after-clone" ]]; then
      emit drush-sapi-i-after-clone.json
    else
      emit drush-sapi-i.json
    fi
    ;;
  sapi-rt|search-api:reset-tracker)       echo "Reset tracker for ${args[1]:-(all)}." ;;
  sapi-c|search-api:clear)                echo "Cleared index ${args[1]:-?}." ;;
  sapi-r|search-api:rebuild-tracker)      echo "Rebuilt tracker for ${args[1]:-(all)}." ;;
  sapi-i|search-api:index)                echo "Indexed items for ${args[1]:-(all)}." ;;
  pm:list|pml)                            emit drush-pm-list.json ;;
  config:get|cget)                        emit drush-config-get.json ;;
  config:set|cset)                        echo "Set ${args[1]:-?} ${args[2]:-?} = ${args[3]:-?}." ;;
  config:export|cex)                      echo "Configuration successfully exported." ;;
  config:import|cim)                      echo "Configuration successfully imported." ;;
  cache:rebuild|cr)                       echo "Cache rebuild complete." ;;
  pm:uninstall|pmu)                       echo "Uninstalled module ${args[1]:-?}." ;;
  en|pm:enable|pm:install)                echo "Enabled module(s): ${args[*]:1}." ;;
  sql:dump|sql-dump)                      echo "Database dump written." ;;
  php:script)
    f="${args[1]:-}"
    case "$f" in
      *clone-index.php)
        # srsx-migrate passes the script's KEY=VALUE inputs as extra args in
        # demo mode, so the shim can echo the same line the real script would.
        idx="(unknown)"
        for a in "${args[@]}"; do
          [[ "$a" == SRSX_INDEX_ID=* ]] && idx="${a#SRSX_INDEX_ID=}"
        done
        echo "[clone-index] OK ${idx} -> searchstax_index"
        touch "$DSTATE/.state-after-clone"
        ;;
      *inspect-index-topology.php)
        echo "[topology] searchstax module version: 1.11.0"
        echo "[topology] solr_to_searchstax_ss_migration: enabled"
        echo "[topology] servers (2):"
        echo "[topology]   acquia_search_server  backend=search_api_solr  connector=solr_acquia_connector  legacy-solr=yes  status=enabled"
        echo "[topology]   searchstax_server  backend=search_api_solr  connector=searchstax  legacy-solr=no  status=enabled"
        echo "[topology] indexes:"
        echo "[topology]   default_index  server(entity)='acquia_search_server'  [legacy]"
        echo "[topology]   products_index  server(entity)='acquia_search_server'  [legacy]"
        printf '[srsx-target]\tok\tsearchstax_server\tsearchstax\n'
        printf '[srsx-index]\tlegacy\tdefault_index\tacquia_search_server\tsearch_api_solr\n'
        printf '[srsx-index]\tlegacy\tproducts_index\tacquia_search_server\tsearch_api_solr\n'
        if [[ -f "$DSTATE/.state-after-clone" ]]; then
          printf '[srsx-index]\ttarget\tsearchstax_index\tsearchstax_server\tsearch_api_solr\n'
        fi
        ;;
      *switch-view-index.php)  cat "$FIX/switch-view-result.txt" 2>/dev/null || echo "Updated views." ;;
      *set-multisite-prefix.php) echo "[set-multisite-prefix] OK (demo)." ;;
      *list-migrated-views.php) echo "[list-migrated-views] view: srsx_demo_search"; echo "[list-migrated-views] 1 view(s) to switch." ;;
      *create-server.php)      echo "[create-server] connector: searchstax (demo)."; echo "[create-server] Saved search_api.server.searchstax_server (demo)." ;;
      *import-config-yaml.php) echo "[import-config-yaml] Imported (demo)." ;;
      *create-key-entity.php)  echo "[create-key-entity] Saved (demo)." ;;
      *)                       echo "[php:script] Ran ${f} (demo)." ;;
    esac
    ;;
  php:eval|php-eval)
    # srsx-migrate inlines lib/php-eval/*.php as a php:eval body tagged with a
    # /*srsx-script:<name>*/ comment; dispatch on that.
    code="${args[1]:-}"
    case "$code" in
      *"srsx-script:clone-index.php"*)        echo "[clone-index] OK (demo) -> searchstax_index" ; touch "$DSTATE/.state-after-clone" ;;
      *"srsx-script:switch-view-index.php"*)  cat "$FIX/switch-view-result.txt" 2>/dev/null || echo "Updated views." ;;
      *"srsx-script:set-multisite-prefix.php"*) echo "[set-multisite-prefix] OK (demo)." ;;
      *"srsx-script:import-config-yaml.php"*) echo "[import-config-yaml] Imported (demo)." ;;
      *"srsx-script:create-key-entity.php"*)  echo "[create-key-entity] Saved (demo)." ;;
      *)                                      echo "[php:eval] (demo)." ;;
    esac
    ;;
  key-add)                                echo "Key added (demo)." ;;
  *)                                      echo "(demo drush) ${sub} ${args[*]:1}" ;;
esac
