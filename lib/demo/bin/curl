#!/usr/bin/env bash
# lib/demo/bin/curl — tripwire shim for --demo mode.
#
# phase_provision and _verify_searchstax_creds both short-circuit in demo mode
# and MUST NOT reach any real HTTP. If a regression ever lets one through, this
# shim fails loudly instead of silently calling out to searchstax.com.

printf 'srsx-migrate demo tripwire: curl invoked in --demo mode.\n' >&2
printf '  args: %s\n' "$*" >&2
printf '  Both provision and configure credential-verify must short-circuit in demo.\n' >&2
exit 97
